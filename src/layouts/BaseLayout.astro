---
import NetworkExtras from '../components/NetworkExtras.astro';
import BaseHead from '@components/BaseHead.astro'
import Footer from '@components/Footer.astro'
import Header from '@components/Header.astro'
import GoogleAnalytics from '@components/support/GoogleAnalytics.astro'
import UmamiAnalytics from '@components/support/UmamiAnalytics.astro'
import { SITE } from '@/config'

interface Props {
    title?: string
    description?: string
    ogImage?: any
    lang?: string
    structuredData?: object
    article?: boolean
    publishedTime?: string
    author?: string
}

const { title, description = SITE.description, ogImage, lang = 'en', structuredData, article = false, publishedTime, author } = Astro.props
const normalizeTitle = !title ? SITE.title : `${title} | ${SITE.title}`
---

<html lang={lang} class="dark scrollbar-hide lenis lenis-smooth scroll-pt-16">
    <head>
        <title>{normalizeTitle}</title>
        <meta name="google-adsense-account" content="ca-pub-8913172270497177">

        <BaseHead
            title={normalizeTitle}
            description={description}
            ogImage={ogImage}
            ogTitle={title === '' ? SITE.title : title}
            ogDescription={description}
            structuredData={structuredData}
            article={article}
            publishedTime={publishedTime}
            author={author}
        />
        <script is:inline>
         localStorage.setItem('hs_theme', 'dark')
         document.documentElement.classList.add('dark')
         </script>
        <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Sora:wght@400;500;600;700;800&display=swap" />
        <script is:inline src="/vendor/lenis/lenis1.1.5.min.js"></script>
        <script is:inline>
        const lenis = new Lenis()
        function raf(time) {
            lenis.raf(time)
            requestAnimationFrame(raf)
        }
        requestAnimationFrame(raf)
        </script>
        <GoogleAnalytics />
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-8913172270497177"
     crossorigin="anonymous"></script>
        <!-- Hotjar (site 6807922) -->
    <script is:inline data-hotjar-id="6807922">
      (function(h,o,t,j,a,r,d){d=document.currentScript;h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};h._hjSettings={hjid:parseInt(d.dataset.hotjarId,10),hjsv:6};a=o.getElementsByTagName('head')[0];r=o.createElement('script');r.async=1;r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;a.appendChild(r);})(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
    </script>
</head>
    <body class="bg-neutral-900 text-neutral-100 selection:bg-orange-500/30 selection:text-white">
        <div class="mx-auto max-w-screen-2xl px-4 sm:px-6 lg:px-8">
            <Header />
            <main>
                <slot />
            </main>
        </div>
        <Footer />
        <style>
            body {
                font-family: 'Nunito', system-ui, sans-serif;
                background: linear-gradient(135deg, #0f172a 0%, #2a1030 100%);
                background-attachment: fixed;
            }
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            html.lenis,
            html.lenis body {
                height: auto;
            }
            .lenis.lenis-smooth {
                scroll-behavior: auto !important;
            }
            .lenis.lenis-smooth [data-lenis-prevent] {
                overscroll-behavior: contain;
            }
            .lenis.lenis-stopped {
                overflow: hidden;
            }
            .lenis.lenis-scrolling iframe {
                pointer-events: none;
            }
        </style>
      <NetworkExtras />
</body>
</html>

