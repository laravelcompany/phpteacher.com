---
import '../styles/network-theme.css';
import NetworkExtras from '../components/NetworkExtras.astro';
import BaseHead from '@components/BaseHead.astro'
import Footer from '@components/Footer.astro'
import Header from '@components/Header.astro'
import GoogleAnalytics from '@components/support/GoogleAnalytics.astro'
import UmamiAnalytics from '@components/support/UmamiAnalytics.astro'
import { SITE } from '@/config'

interface Props {
    title?: string
    description?: string
    ogImage?: any
    lang?: string
    structuredData?: object
    article?: boolean
    publishedTime?: string
    author?: string
}

const { title, description = SITE.description, ogImage, lang = 'en', structuredData, article = false, publishedTime, author } = Astro.props
const normalizeTitle = !title ? SITE.title : `${title} | ${SITE.title}`
---

<html lang={lang} class="dark scrollbar-hide lenis lenis-smooth scroll-pt-16">
    <head>
    <!-- Google Tag Manager -->
    <script is:inline async src="https://www.googletagmanager.com/gtm.js?id=GTM-TD9VQSPB"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
    </script>
    <!-- End Google Tag Manager -->
        <title>{normalizeTitle}</title>
        <meta name="google-adsense-account" content="ca-pub-6836700493760647">

        <BaseHead
            title={normalizeTitle}
            description={description}
            ogImage={ogImage}
            ogTitle={title === '' ? SITE.title : title}
            ogDescription={description}
            structuredData={structuredData}
            article={article}
            publishedTime={publishedTime}
            author={author}
        />
        <script is:inline>
         localStorage.setItem('hs_theme', 'dark')
         document.documentElement.classList.add('dark')
         </script>
        <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito:wght@400;600;700;800;900&family=Sora:wght@400;500;600;700;800&display=swap" />
        <GoogleAnalytics />
        <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-6836700493760647"
     crossorigin="anonymous"></script>
        <!-- Hotjar (site 6807922) -->
    <script is:inline data-hotjar-id="6807922">
      (function(h,o,t,j,a,r,d){d=document.currentScript;h.hj=h.hj||function(){(h.hj.q=h.hj.q||[]).push(arguments)};h._hjSettings={hjid:parseInt(d.dataset.hotjarId,10),hjsv:6};a=o.getElementsByTagName('head')[0];r=o.createElement('script');r.async=1;r.src=t+h._hjSettings.hjid+j+h._hjSettings.hjsv;a.appendChild(r);})(window,document,'https://static.hotjar.com/c/hotjar-','.js?sv=');
    </script>
</head>
    <body class="bg-neutral-900 text-neutral-100 selection:bg-orange-500/30 selection:text-white">
        <a href="#main-content" class="skip-link">Skip to content</a>
        <Header />
        <main id="main-content" class="site-main" tabindex="-1">
            <slot />
        </main>
        <Footer />
      <NetworkExtras />
      <style is:global>
        /* Google Funding Choices renders the consent dialog skeleton (icons,
           empty buttons) seconds before its text arrives; keep it invisible
           until populated so nobody sees a blank modal. */
        .fc-dialog-container.fc-pending {
            visibility: hidden;
        }
      </style>
      <script is:inline>
        (function () {
          var tries = 0;
          var timer = setInterval(function () {
            var d = document.querySelector('.fc-dialog-container');
            if (d) {
              var ready = (d.innerText || '').trim().length > 50;
              d.classList.toggle('fc-pending', !ready);
              if (ready) clearInterval(timer);
            }
            if (++tries > 100) clearInterval(timer);
          }, 150);
        })();
      </script>
</body>
</html>

