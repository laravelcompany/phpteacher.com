---
import type { CollectionEntry } from 'astro:content'
import Icon from '@components/ui/icons/icon.astro'
import Image from '@components/ui/images/Image.astro'

const { blog } = Astro.props

interface Props {
    blog: CollectionEntry<'posts'>
}
---

<a
    class="group outline-none rounded-xl ring-zinc-500 transition duration-300 focus-visible:ring dark:ring-zinc-200 dark:focus:outline-none"
    href={`/posts/${blog.slug}/`}
    data-astro-prefetch
>
    <div class="aspect-w-16 aspect-h-10 relative overflow-hidden rounded-xl">
        <Image
            class="w-full h-full sm:h-[220px] md:h-[240px] object-cover rounded-xl transition duration-500 ease-in-out group-hover:scale-105"
            src={blog.data.banner}
            alt={blog.data.title}
            format="avif"
            loading="lazy"
            width="850"
            height="440"
        />
        <div class="absolute top-3 left-3">
            <span class="px-2.5 py-1 text-xs font-semibold text-white bg-orange-600 rounded-md shadow-sm">
                {blog.data.category}
            </span>
        </div>
    </div>

    <div class="mt-5">
        <div class="flex items-center gap-2 mb-3">
            <time class="text-sm text-neutral-500 dark:text-neutral-400">
                {blog.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
            </time>
            {blog.data.tags && blog.data.tags.length > 0 && (
                <span class="text-xs text-neutral-400 dark:text-neutral-500">
                    · {blog.data.tags.slice(0, 2).join(', ')}
                </span>
            )}
        </div>
        <h3
            class="text-lg font-bold text-neutral-800 group-hover:text-orange-600 dark:text-neutral-200 dark:group-hover:text-orange-400 transition-colors line-clamp-2"
        >
            {blog.data.title}
         </h3>

        <p class="mt-2 text-sm text-neutral-600 dark:text-neutral-400 line-clamp-2">
          {blog.data.description}
        </p>

        <div
            class="mt-4 inline-flex items-center gap-1 font-medium text-orange-500 decoration-2 group-hover:underline dark:text-orange-400"
        >
            Read more <Icon name="arrowRightStatic" />
        </div>
    </div>
</a>
