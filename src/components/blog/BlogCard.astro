---
import type { CollectionEntry } from 'astro:content'
import Image from '@components/ui/images/Image.astro'
import { formatDate } from '@support/time'

const { blog } = Astro.props

interface Props {
    blog: CollectionEntry<'posts'>
}

const categoryColorMap: Record<string, string> = {
    php: 'bg-orange-100 text-orange-700 dark:bg-orange-900/20 dark:text-orange-300 border-orange-200 dark:border-orange-800',
    laravel: 'bg-red-100 text-red-700 dark:bg-red-900/20 dark:text-red-300 border-red-200 dark:border-red-800',
    books: 'bg-blue-100 text-blue-700 dark:bg-blue-900/20 dark:text-blue-300 border-blue-200 dark:border-blue-800',
    ddd: 'bg-purple-100 text-purple-700 dark:bg-purple-900/20 dark:text-purple-300 border-purple-200 dark:border-purple-800',
    drupal: 'bg-cyan-100 text-cyan-700 dark:bg-cyan-900/20 dark:text-cyan-300 border-cyan-200 dark:border-cyan-800',
    security: 'bg-red-100 text-red-700 dark:bg-red-900/20 dark:text-red-300 border-red-200 dark:border-red-800',
    career: 'bg-green-100 text-green-700 dark:bg-green-900/20 dark:text-green-300 border-green-200 dark:border-green-800',
    tool: 'bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 border-neutral-200 dark:border-neutral-700',
    news: 'bg-yellow-100 text-yellow-700 dark:bg-yellow-900/20 dark:text-yellow-300 border-yellow-200 dark:border-yellow-800',
    seo: 'bg-teal-100 text-teal-700 dark:bg-teal-900/20 dark:text-teal-300 border-teal-200 dark:border-teal-800',
    kubernetes: 'bg-indigo-100 text-indigo-700 dark:bg-indigo-900/20 dark:text-indigo-300 border-indigo-200 dark:border-indigo-800',
}
const cat = blog.data.category.toLowerCase()
const colorClass = categoryColorMap[cat] || 'bg-neutral-100 text-neutral-700 dark:bg-neutral-800 dark:text-neutral-300 border-neutral-200 dark:border-neutral-700'
---

<a
    class="group relative block rounded-xl outline-none ring-zinc-500 transition duration-500 focus-visible:ring dark:ring-zinc-200 dark:focus:outline-none bg-white dark:bg-neutral-900 shadow-md hover:shadow-xl hover:-translate-y-0.5 border border-neutral-200 dark:border-neutral-700 overflow-hidden"
    href={`/posts/${blog.slug}/`}
    data-astro-prefetch="false"
    data-category={blog.data.category}
>
    <div class="relative w-full flex-shrink-0 overflow-hidden before:absolute before:inset-x-0 before:z-[1] before:size-full before:bg-gradient-to-t before:from-neutral-900/[.7]">
        <Image
            class="w-full h-40 sm:h-44 start-0 top-0 size-full object-cover transition duration-500 group-hover:scale-110"
            src={blog.data.banner}
            alt={blog.data.title}
            draggable="false"
            loading="eager"
            format="avif"
            width="800"
            height="460"
        />
        <div class="absolute top-3 left-3 z-[2]">
            <span class="inline-flex items-center px-2 py-0.5 text-[10px] font-semibold rounded-md border {colorClass}">
                {blog.data.category}
            </span>
        </div>
    </div>
    <div class="p-4">
        <h3 class="text-sm font-bold text-neutral-800 group-hover:text-orange-500 dark:text-neutral-200 dark:group-hover:text-orange-300 leading-snug line-clamp-2">
            {blog.data.title}
        </h3>
        <p class="mt-2 text-xs text-gray-600 dark:text-neutral-400">
            {formatDate(blog.data.pubDate)}
        </p>
    </div>
</a>
