---
import BrandLogo from '@components/ui/logos/BrandLogo.astro'
import Image from '@components/ui/images/Image.astro'
import footerBanner from '@images/logo2.svg'
import { FooterLinks, SITE } from '@/config'
---

<footer class="w-full bg-neutral-300 dark:bg-neutral-900 border-t border-neutral-400/30 dark:border-neutral-700/50">
    <div class="mx-auto w-full max-w-[85rem] px-4 py-12 sm:px-6 lg:px-16 lg:pt-16 2xl:max-w-screen-2xl">
        <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 md:grid-cols-4 lg:grid-cols-5">
            <div class="col-span-full sm:col-span-1 flex flex-col items-center sm:items-start">
                <BrandLogo class="h-12 w-auto mb-4" />
                <p class="text-sm text-neutral-600 dark:text-neutral-400 text-center sm:text-left">
                    Free PHP learning resources for developers of all levels.
                </p>
            </div>
            {
                FooterLinks.map(section => (
                    <div class="col-span-1 text-center sm:text-left">
                        <h3 class="font-semibold text-neutral-800 dark:text-neutral-200 mb-4">
                            {section.section}
                        </h3>
                        <ul class="space-y-3">
                                {section.links.map((link, _index) => (
                                        <li>
                                            <a
                                                href={link.url}
                                                class="inline-flex text-neutral-600 hover:text-orange-600 dark:text-neutral-400 dark:hover:text-orange-400 transition-colors text-sm"
                                            >
                                                {link.name}
                                            </a>
                                        </li>
                                ))}
                            </ul>
                    </div>
                ))
            }
        </div>

        <div class="mt-12 pt-8 border-t border-neutral-400/30 dark:border-neutral-700/50">
            <div class="flex flex-col md:flex-row items-center justify-between gap-4">
                <div class="flex items-center gap-2">
                    <a href="https://laravelcompany.com" class="flex items-center gap-2">
                        <img alt="Laravel Company Logo" src="https://laravelcompany.com/logo.svg" class="h-6">
                        <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">Laravel Company</span>
                    </a>
                </div>
                <p class="text-sm text-neutral-500 dark:text-neutral-500">
                    Part of the Laravel Company ecosystem delivering integrated messaging, e-commerce, and SEO solutions.
                </p>
                <span class="text-sm text-neutral-500 dark:text-neutral-500">© 2026 Laravel Software. All Rights Reserved.</span>
            </div>
        </div>
    </div>
</footer>
