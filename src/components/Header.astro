---
import BrandLogo from '@components/ui/logos/BrandLogo.astro'
import AlgoliaDocSearch from './support/search/AlgoliaDocSearch'
import { NavigationLinks } from '@/config'

const current = Astro.url.pathname
const isActive = (url: string) => current === url || current.startsWith(url)
---

<header id="main-header" class="site-header sticky top-0 z-50 -mx-4 sm:-mx-6 lg:-mx-8" role="banner">
    <div class="header-bar mx-auto flex h-20 max-w-screen-2xl items-center justify-between px-4 sm:px-6 lg:px-8">
        <a
            href="/"
            aria-label="PHP Teacher home"
            class="flex items-center gap-3 rounded transition-transform duration-300 hover:scale-105 focus:outline-none focus-visible:ring-2 focus-visible:ring-orange-500 focus-visible:ring-offset-2 focus-visible:ring-offset-neutral-900"
        >
            <BrandLogo class="h-10 w-auto" />
            <span class="text-xl font-black tracking-tight text-white">PHP Teacher</span>
        </a>

        <nav class="hidden items-center space-x-2 lg:flex" aria-label="Main navigation">
            {NavigationLinks.map(link => (
                <a
                    href={link.url}
                    class:list={['nav-link px-3 py-2', { active: isActive(link.url) }]}
                    aria-current={isActive(link.url) ? 'page' : undefined}
                >
                    {link.name}
                </a>
            ))}
        </nav>

        <div class="flex items-center gap-3">
            <div class="hidden lg:block">
                <AlgoliaDocSearch client:only="react" />
            </div>
            <a href="/manual/" class="btn-cta hidden lg:inline-flex">Read the Manual</a>
            <div class="lg:hidden">
                <AlgoliaDocSearch client:only="react" />
            </div>
            <button
                id="menu-toggle"
                type="button"
                class="menu-toggle flex h-10 w-10 flex-col items-center justify-center lg:hidden"
                aria-label="Toggle navigation menu"
                aria-expanded="false"
                aria-controls="mobile-menu"
            >
                <span class="bar line-1"></span>
                <span class="bar line-2"></span>
                <span class="bar line-3"></span>
            </button>
        </div>
    </div>

    <div id="mobile-menu" class="mobile-menu">
        <nav class="mx-auto flex max-w-screen-2xl flex-col space-y-2 px-4 py-6 sm:px-6" aria-label="Mobile navigation">
            {NavigationLinks.map(link => (
                <a href={link.url} class="mobile-menu-item">{link.name}</a>
            ))}
            <a href="/manual/" class="mobile-menu-cta">Read the Manual</a>
        </nav>
    </div>
</header>

<style is:global>
    .site-header {
        background: rgba(15, 23, 42, 0.8);
        backdrop-filter: blur(16px);
        border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }
    .site-header .nav-link {
        position: relative;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 600;
        font-size: 0.9rem;
        transition: color 0.3s ease;
    }
    .site-header .nav-link:hover,
    .site-header .nav-link.active { color: #fff; }
    .site-header .nav-link::after {
        content: '';
        position: absolute;
        bottom: -4px;
        left: 0;
        width: 0;
        height: 2px;
        background: linear-gradient(to right, #8b5cf6, #ec4899);
        border-radius: 2px;
        transition: width 0.3s ease;
    }
    .site-header .nav-link:hover::after,
    .site-header .nav-link.active::after { width: 100%; }
    .site-header .btn-cta {
        align-items: center;
        padding: 0.65rem 1.4rem;
        border-radius: 0.75rem;
        background: #7c3aed;
        color: #fff;
        font-weight: 700;
        font-size: 0.9rem;
        box-shadow: 0 10px 15px -3px #0000001a, 0 0 0 4px rgba(124, 58, 237, 0.25);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .site-header .btn-cta:hover {
        transform: scale(1.05);
        box-shadow: 0 10px 15px -3px #0000001a, 0 0 0 4px rgba(124, 58, 237, 0.4);
    }
    .site-header .menu-toggle {
        border-radius: 1rem;
        border: 1px solid rgba(255, 255, 255, 0.1);
        background: rgba(255, 255, 255, 0.05);
        backdrop-filter: blur(12px);
        cursor: pointer;
    }
    .site-header .menu-toggle .bar {
        display: block;
        width: 1.5rem;
        height: 2px;
        background: #fff;
        transition: all 0.3s ease;
    }
    .site-header .menu-toggle .line-1,
    .site-header .menu-toggle .line-2 { margin-bottom: 6px; }
    .site-header .menu-toggle.open .line-1 { transform: translateY(8px) rotate(45deg); }
    .site-header .menu-toggle.open .line-2 { opacity: 0; }
    .site-header .menu-toggle.open .line-3 { transform: translateY(-8px) rotate(-45deg); }
    .site-header .mobile-menu {
        display: none;
        background: rgba(15, 23, 42, 0.95);
        backdrop-filter: blur(20px);
        border-top: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.5);
    }
    .site-header .mobile-menu.active { display: block; }
    .site-header .mobile-menu-item {
        display: block;
        color: #fff;
        font-size: 1.125rem;
        font-weight: 600;
        padding: 1rem;
        border-radius: 1rem;
        background: rgba(255, 255, 255, 0.05);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transition: all 0.3s ease;
    }
    .site-header .mobile-menu-item:hover { background: rgba(255, 255, 255, 0.1); }
    .site-header .mobile-menu-cta {
        display: block;
        color: #fff;
        font-size: 1.125rem;
        font-weight: 700;
        padding: 1rem 1.5rem;
        border-radius: 1rem;
        background: linear-gradient(to right, #7c3aed, #ec4899);
        text-align: center;
        margin-top: 1rem;
        box-shadow: 0 4px 15px rgba(124, 58, 237, 0.4);
    }
</style>

<script is:inline>
    (function () {
        var btn = document.getElementById('menu-toggle')
        var menu = document.getElementById('mobile-menu')
        if (!btn || !menu) return
        btn.addEventListener('click', function () {
            var open = menu.classList.toggle('active')
            btn.classList.toggle('open', open)
            btn.setAttribute('aria-expanded', open ? 'true' : 'false')
        })
    })()
</script>
