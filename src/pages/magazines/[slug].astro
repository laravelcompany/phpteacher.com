---
import BaseLayout from '@layouts/BaseLayout.astro'
import { SITE } from '@/config'
import fs from 'node:fs'
import path from 'node:path'

interface Magazine {
    slug: string; year: string | undefined; month: string | undefined; date: Date;
    pdf: string | undefined; pdfSize: string | null;
    epub: string | undefined; epubSize: string | null;
    mobi: string | undefined; mobiSize: string | null;
    hasCode: boolean; codeDirName: string | null; dirPath: string;
}

export function getStaticPaths() {
    const dir = path.join(process.cwd(), 'static/magazines')
    const magazines = fs.readdirSync(dir, { withFileTypes: true })
        .filter((d: fs.Dirent) => d.isDirectory())
        .map((d: fs.Dirent) => {
            const name = d.name
            const m = name.match(/phparchitect-(\d{4})-(\d{2})/)
            const dirPath = path.join(dir, name)
            const files = fs.readdirSync(dirPath)
            const dt = m?.[2] && m?.[1] ? new Date(parseInt(m[1]), parseInt(m[2]) - 1) : new Date()

            const getSize = (fileName: string | undefined): string | null => {
                if (!fileName) return null
                try {
                    const bytes = fs.statSync(path.join(dirPath, fileName)).size
                    if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB'
                    return (bytes / (1024 * 1024)).toFixed(1) + ' MB'
                } catch { return null }
            }

            const pdf = files.find((f: string) => f.endsWith('.pdf'))
            const epub = files.find((f: string) => f.endsWith('.epub'))
            const mobi = files.find((f: string) => f.endsWith('.mobi'))
            const codeDir = files.find((f: string) => f.startsWith('code_'))

            return {
                slug: name, year: m?.[1], month: m?.[2], date: dt,
                pdf, pdfSize: getSize(pdf),
                epub, epubSize: getSize(epub),
                mobi, mobiSize: getSize(mobi),
                hasCode: !!codeDir,
                codeDirName: codeDir || null,
                dirPath,
            } as Magazine
        })
    return magazines.map((mag: Magazine) => ({
        params: { slug: mag.slug },
        props: { mag },
    }))
}

const { mag } = Astro.props as { mag: Magazine }
const quarter = mag.month ? `Q${Math.ceil(parseInt(mag.month) / 3)}` : ''
const formattedDate = mag.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })
const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
const monthName = mag.month ? monthNames[parseInt(mag.month) - 1] : ''

type FormatKey = 'pdf' | 'epub' | 'mobi'
const formats: { key: FormatKey; label: string; color: string; icon: string }[] = [
    { key: 'pdf', label: 'PDF', color: 'red', icon: 'M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z' },
    { key: 'epub', label: 'EPUB', color: 'green', icon: 'M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253' },
    { key: 'mobi', label: 'MOBI', color: 'purple', icon: 'M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z' },
]

let codeFiles: string[] = []
if (mag.hasCode && mag.codeDirName) {
    try {
        const codePath = path.join(mag.dirPath, mag.codeDirName)
        const all = fs.readdirSync(codePath, { recursive: true }) as string[]
        codeFiles = all.filter((f: string) => f.endsWith('.php') || f.endsWith('.html') || f.endsWith('.js') || f.endsWith('.css') || f.endsWith('.json')).slice(0, 20)
    } catch {}
}
---

<BaseLayout
    title={`php|architect ${mag.year} ${quarter}`}
    description={`Download php|architect ${formattedDate} magazine edition in PDF, EPUB, and MOBI formats.`}
>
    <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE.url },
            { '@type': 'ListItem', 'position': 2, 'name': 'Magazines', 'item': SITE.url + '/magazines/' },
            { '@type': 'ListItem', 'position': 3, 'name': `php|architect ${mag.year} ${quarter}`, 'item': Astro.url.href },
        ],
    })} />
    <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
        <div class="mx-auto max-w-4xl">
            <a href="/magazines" class="inline-flex items-center text-orange-600 hover:text-orange-800 dark:text-orange-400 dark:hover:text-orange-300 mb-8 transition-colors font-medium group">
                <svg class="w-4 h-4 mr-2 group-hover:-translate-x-0.5 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
                Back to all magazines
            </a>

            <div class="bg-white dark:bg-neutral-900 rounded-2xl shadow-lg overflow-hidden border-t-4 border-orange-500">
                <div class="h-48 bg-gradient-to-br from-orange-500 via-orange-600 to-amber-700 flex flex-col items-center justify-center relative">
                    <div class="text-center">
                        <p class="text-white/60 text-xs font-medium uppercase tracking-[0.2em] mb-2">php|architect</p>
                        <h1 class="text-white text-3xl md:text-4xl font-bold leading-tight">
                            {mag.year}
                        </h1>
                        <div class="w-12 h-0.5 bg-white/40 mx-auto my-3"></div>
                        <p class="text-white/90 text-base md:text-lg font-medium">
                            {monthName}
                        </p>
                    </div>
                </div>

                <div class="px-6 sm:px-8 pb-8">
                    <div class="-mt-8 mb-8">
                        <div class="inline-block bg-white dark:bg-neutral-800 rounded-xl shadow-lg px-8 py-6 border-2 border-white dark:border-neutral-900">
                            <h1 class="text-2xl md:text-3xl font-bold text-neutral-800 dark:text-neutral-100">
                                php|architect {mag.year} {quarter}
                            </h1>
                            <p class="text-base md:text-lg text-neutral-600 dark:text-neutral-300 mt-2">
                                {formattedDate}
                            </p>
                        </div>
                    </div>

                    <h2 class="text-xl font-semibold text-neutral-800 dark:text-neutral-200 mb-5 flex items-center gap-2">
                        <svg class="w-5 h-5 text-orange-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                        </svg>
                        Download Formats
                    </h2>
                    <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
                        {formats.filter(f => mag[f.key]).map(f => {
                            const sizeKey = `${f.key}Size` as keyof Magazine
                            const size = mag[sizeKey] as string | null
                            return (
                            <a href={`/magazines/${mag.slug}/${mag[f.key]}`} download
                               class={`block p-5 rounded-xl border-2 border-${f.color}-200 dark:border-${f.color}-800 bg-${f.color}-50 dark:bg-${f.color}-900/20 hover:bg-${f.color}-100 dark:hover:bg-${f.color}-900/40 hover:shadow-md transition-all duration-200 group`}>
                                <div class="flex items-center justify-between mb-3">
                                    <span class="flex items-center gap-2 text-lg font-semibold text-neutral-800 dark:text-neutral-200">
                                        <svg class={`w-5 h-5 text-${f.color}-500`} fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={f.icon}/></svg>
                                        {f.label}
                                    </span>
                                    <svg class={`w-5 h-5 text-${f.color}-500 group-hover:translate-y-0.5 transition-transform`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                                    </svg>
                                </div>
                                <p class={`text-sm text-${f.color}-600 dark:text-${f.color}-400 font-medium`}>
                                    {size ? `Download ${f.label} (${size})` : `Download ${f.label}`}
                                </p>
                            </a>
                            )
                        })}
                    </div>

                    {mag.hasCode && (
                        <>
                            <h2 class="text-xl font-semibold text-neutral-800 dark:text-neutral-200 mb-5 mt-10 flex items-center gap-2">
                                <svg class="w-5 h-5 text-cyan-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
                                </svg>
                                Code Examples
                            </h2>
                            <div class="bg-cyan-50 dark:bg-cyan-900/10 rounded-xl border border-cyan-200 dark:border-cyan-800 p-6">
                                <p class="text-neutral-700 dark:text-neutral-300 text-sm mb-4">
                                    This issue includes code examples. The files are available inside the magazine download.
                                </p>
                                {codeFiles.length > 0 && (
                                    <div class="grid gap-1.5">
                                        <p class="text-xs font-semibold text-neutral-500 dark:text-neutral-400 uppercase tracking-wider mb-1">Files included:</p>
                                        {codeFiles.map(f => (
                                            <div class="flex items-center gap-2 text-xs text-neutral-600 dark:text-neutral-400 font-mono">
                                                <svg class="w-3.5 h-3.5 text-cyan-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                                                <span class="truncate">{f}</span>
                                            </div>
                                        ))}
                                    </div>
                                )}
                            </div>
                        </>
                    )}
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
