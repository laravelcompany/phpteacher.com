---
import BaseLayout from '@layouts/BaseLayout.astro'
import MainSection from '@components/ui/sections/MainSection.astro'
import { SITE } from '@/config'
import fs from 'node:fs'
import path from 'node:path'

const magazinesDir = path.join(process.cwd(), 'static/magazines')

const folders = fs.readdirSync(magazinesDir, { withFileTypes: true })
    .filter((dirent: fs.Dirent) => dirent.isDirectory())
    .map((dirent: fs.Dirent) => {
        const folderName = dirent.name
        const match = folderName.match(/phparchitect-(\d{4})-(\d{2})/)
        const year = match?.[1]
        const month = match?.[2]
        
        const dirPath = path.join(magazinesDir, folderName)
        const files = fs.readdirSync(dirPath)
        const pdf = files.find(f => f.endsWith('.pdf'))
        const epub = files.find(f => f.endsWith('.epub'))
        const mobi = files.find(f => f.endsWith('.mobi'))
        const codeDir = files.find(f => f.startsWith('code_'))
        
        const date = month && year ? new Date(parseInt(year), parseInt(month) - 1) : new Date()

        const getSize = (name: string | undefined): string | null => {
            if (!name) return null
            try {
                const bytes = fs.statSync(path.join(dirPath, name)).size
                if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(0) + ' KB'
                return (bytes / (1024 * 1024)).toFixed(1) + ' MB'
            } catch { return null }
        }
        
        return {
            slug: folderName,
            year,
            month,
            date,
            pdf, pdfSize: getSize(pdf),
            epub, epubSize: getSize(epub),
            mobi, mobiSize: getSize(mobi),
            hasCode: !!codeDir,
        }
    })
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())

const years = [...new Set(folders.map(m => m.year).filter(Boolean))].sort().reverse()
const totalFormats = folders.reduce((acc, m) => acc + (m.pdf ? 1 : 0) + (m.epub ? 1 : 0) + (m.mobi ? 1 : 0), 0)
const description = 'Download php|architect magazine editions - PHP tutorials, articles, and best practices.'
const URL = Astro.url.href
const monthNames = ['January', 'February', 'March', 'April', 'May', 'June', 'July', 'August', 'September', 'October', 'November', 'December']
---

<BaseLayout
    title="Magazines"
    description={description}
    structuredData={{
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        'inLanguage': 'en-US',
        '@id': URL,
        'url': URL,
        'name': `Magazines - ${SITE.title}`,
        'description': description,
        'isPartOf': {
            '@type': 'WebSite',
            'url': SITE.url,
            'name': SITE.title,
            'description': SITE.description,
        },
    }}
>
    <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE.url },
            { '@type': 'ListItem', 'position': 2, 'name': 'Magazines', 'item': URL },
        ],
    })} />
    <MainSection
        title="php|architect Magazines"
        subTitle="Download PDF, EPUB, and MOBI editions"
        btnExists={false}
    />

    <section class="max-w-8xl mx-auto px-4 pb-12">

        <div class="flex flex-wrap items-center justify-between gap-4 mb-8">
            <div class="flex items-center gap-4 text-sm text-neutral-600 dark:text-neutral-400">
                <span class="flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                    <span><strong class="text-neutral-800 dark:text-neutral-200">{folders.length}</strong> issues</span>
                </span>
                <span class="flex items-center gap-1.5">
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
                    <span><strong class="text-neutral-800 dark:text-neutral-200">{totalFormats}</strong> downloads</span>
                </span>
            </div>

            <div class="flex flex-wrap gap-2" id="yearFilters">
                <button data-year="all" class="year-filter active px-3 py-1.5 text-xs font-semibold rounded-lg bg-orange-500 text-white shadow-sm transition-all">All</button>
                {years.map(y => (
                    <button data-year={y} class="year-filter px-3 py-1.5 text-xs font-semibold rounded-lg bg-neutral-100 dark:bg-neutral-800 text-neutral-600 dark:text-neutral-300 hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-all">{y}</button>
                ))}
            </div>
        </div>

        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4" id="magazineGrid">
            {folders.map((mag, idx) => (
                <a href={`/magazines/${mag.slug}`} data-year={mag.year}
                   class="mag-card group block bg-white dark:bg-neutral-900 rounded-xl shadow-md hover:shadow-2xl hover:-translate-y-1 transition-all duration-300 overflow-hidden border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-600">
                    <div class="h-40 bg-gradient-to-br from-orange-500 via-orange-600 to-amber-700 flex flex-col items-center justify-center relative px-4">
                        {idx === 0 && (
                            <span class="absolute top-2.5 right-2.5 inline-flex items-center gap-1 px-2 py-0.5 bg-yellow-400 text-neutral-900 text-[10px] font-bold rounded-full shadow-lg">
                                <svg class="w-2.5 h-2.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                                Latest
                            </span>
                        )}
                        <div class="text-center">
                            <p class="text-white/60 text-[10px] font-medium uppercase tracking-[0.15em] mb-1.5">php|architect</p>
                            <h3 class="text-white text-xl font-bold leading-tight">
                                {mag.year}
                            </h3>
                            <div class="w-8 h-0.5 bg-white/40 mx-auto my-1.5"></div>
                            <p class="text-white/90 text-xs font-medium">
                                {mag.month ? monthNames[parseInt(mag.month) - 1] : ''}
                            </p>
                        </div>
                    </div>
                    
                    <div class="p-4">
                        <p class="text-[10px] text-neutral-500 dark:text-neutral-400 uppercase tracking-wider font-medium mb-0.5">
                            {mag.year} {mag.month ? `Q${Math.ceil(parseInt(mag.month) / 3)}` : ''}
                        </p>
                        <h3 class="text-sm font-bold text-neutral-800 dark:text-neutral-200 mb-2.5 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors leading-snug">
                            php|architect {mag.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
                        </h3>
                        <div class="flex flex-wrap gap-1.5">
                            {mag.pdf && (
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-red-50 dark:bg-red-900/20 text-red-700 dark:text-red-300 rounded-md text-[10px] font-semibold border border-red-200 dark:border-red-800">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 21h10a2 2 0 002-2V9.414a1 1 0 00-.293-.707l-5.414-5.414A1 1 0 0012.586 3H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                    <span>PDF</span>
                                    {mag.pdfSize && <span class="text-[9px] opacity-70">({mag.pdfSize})</span>}
                                </span>
                            )}
                            {mag.epub && (
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-green-50 dark:bg-green-900/20 text-green-700 dark:text-green-300 rounded-md text-[10px] font-semibold border border-green-200 dark:border-green-800">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253"/></svg>
                                    <span>EPUB</span>
                                    {mag.epubSize && <span class="text-[9px] opacity-70">({mag.epubSize})</span>}
                                </span>
                            )}
                            {mag.mobi && (
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-purple-50 dark:bg-purple-900/20 text-purple-700 dark:text-purple-300 rounded-md text-[10px] font-semibold border border-purple-200 dark:border-purple-800">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 18h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z"/></svg>
                                    <span>MOBI</span>
                                    {mag.mobiSize && <span class="text-[9px] opacity-70">({mag.mobiSize})</span>}
                                </span>
                            )}
                            {mag.hasCode && (
                                <span class="inline-flex items-center gap-1 px-2 py-1 bg-cyan-50 dark:bg-cyan-900/20 text-cyan-700 dark:text-cyan-300 rounded-md text-[10px] font-semibold border border-cyan-200 dark:border-cyan-800">
                                    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/></svg>
                                    Code
                                </span>
                            )}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>
</BaseLayout>

<script>
    const filters = document.querySelectorAll('.year-filter')
    const cards = document.querySelectorAll('.mag-card')

    filters.forEach((btn: any) => {
        btn.addEventListener('click', () => {
            filters.forEach((b: any) => {
                b.classList.remove('active', 'bg-orange-500', 'text-white')
                b.classList.add('bg-neutral-100', 'dark:bg-neutral-800', 'text-neutral-600', 'dark:text-neutral-300')
            })
            btn.classList.add('active', 'bg-orange-500', 'text-white')
            btn.classList.remove('bg-neutral-100', 'dark:bg-neutral-800', 'text-neutral-600', 'dark:text-neutral-300')

            const year = btn.dataset.year
            cards.forEach((card: any) => {
                if (year === 'all' || card.dataset.year === year) {
                    card.style.display = ''
                } else {
                    card.style.display = 'none'
                }
            })
        })
    })
</script>
