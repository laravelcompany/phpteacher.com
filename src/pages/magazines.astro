---
import BaseLayout from '@layouts/BaseLayout.astro'
import MainSection from '@components/ui/sections/MainSection.astro'
import { SITE } from '@/config'
import fs from 'node:fs'
import path from 'node:path'

const magazinesDir = path.join(process.cwd(), 'static/magazines')

const folders = fs.readdirSync(magazinesDir, { withFileTypes: true })
    .filter(dirent => dirent.isDirectory())
    .map(dirent => {
        const folderName = dirent.name
        const match = folderName.match(/phparchitect-(\d{4})-(\d{2})/)
        const year = match?.[1]
        const month = match?.[2]
        
        const files = fs.readdirSync(path.join(magazinesDir, folderName))
        const pdf = files.find(f => f.endsWith('.pdf'))
        const epub = files.find(f => f.endsWith('.epub'))
        const mobi = files.find(f => f.endsWith('.mobi'))
        
        const date = month && year ? new Date(parseInt(year), parseInt(month) - 1) : new Date()
        
        return {
            slug: folderName,
            year,
            month,
            date,
            pdf,
            epub,
            mobi,
        }
    })
    .sort((a, b) => b.date.valueOf() - a.date.valueOf())

const description = 'Download php|architect magazine editions - PHP tutorials, articles, and best practices.'
const URL = Astro.url.href
---

<BaseLayout
    title="Magazines"
    description={description}
    structuredData={{
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        'inLanguage': 'en-US',
        '@id': URL,
        'url': URL,
        'name': `Magazines - ${SITE.title}`,
        'description': description,
        'isPartOf': {
            '@type': 'WebSite',
            'url': SITE.url,
            'name': SITE.title,
            'description': SITE.description,
        },
    }}
>
    <MainSection
        title="php|architect Magazines"
        subTitle="Download PDF, EPUB, and MOBI editions"
        btnExists={false}
    />

    <section class="max-w-4xl mx-auto px-4 py-12">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {folders.map((mag) => (
                <a href={`/magazines/${mag.slug}`} class="group block bg-white dark:bg-neutral-900 rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-transparent hover:border-orange-300 dark:hover:border-orange-700">
                    <div class="h-32 bg-gradient-to-br from-orange-500 to-amber-600 flex items-center justify-center relative">
                        <img src="/logo.svg" alt="" class="w-20 h-20 text-white/30" />
                    </div>
                    
                    <div class="p-5">
                        <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-1 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
                            php|architect {mag.year} {mag.month ? `Q${Math.ceil(parseInt(mag.month) / 3)}` : ''}
                        </h3>
                        <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-4">
                            {mag.date.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
                        </p>
                        <div class="flex flex-wrap gap-2">
                            {mag.pdf && (
                                <span class="inline-flex items-center px-3 py-1.5 bg-blue-600 text-white rounded-md text-xs font-medium">
                                    PDF
                                </span>
                            )}
                            {mag.epub && (
                                <span class="inline-flex items-center px-3 py-1.5 bg-green-600 text-white rounded-md text-xs font-medium">
                                    EPUB
                                </span>
                            )}
                            {mag.mobi && (
                                <span class="inline-flex items-center px-3 py-1.5 bg-orange-600 text-white rounded-md text-xs font-medium">
                                    MOBI
                                </span>
                            )}
                        </div>
                    </div>
                </a>
            ))}
        </div>
    </section>
</BaseLayout>
