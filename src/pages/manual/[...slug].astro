---
import BaseLayout from '@layouts/BaseLayout.astro'

export async function getStaticPaths() {
  const manualFiles = await import.meta.glob('/src/manual/*.html', { query: '?raw', import: 'default', eager: true })
  
  const entries = Object.keys(manualFiles).map(file => {
    const slug = file.replace('/src/manual/', '').replace('.html', '')
    return { 
      params: { slug }, 
      props: { html: manualFiles[file] } 
    }
  })

  entries.push({ params: { slug: '' }, props: { html: manualFiles['/src/manual/index.html'] } })
  
  return entries
}

const { html } = Astro.props
const fullHtml = html

const bodyContent = fullHtml
  .replace(/<!DOCTYPE[^>]*>/i, '')
  .replace(/<html[^>]*>/i, '')
  .replace(/<\/html>/i, '')
  .replace(/<head>[\s\S]*<\/head>/i, '')
  .replace(/<body[^>]*>/i, '')
  .replace(/<\/body>/i, '')
---

<BaseLayout title="PHP Manual">
  <div class="php-manual">
    <div class="php-manual-content" set:html={bodyContent} />
  </div>
</BaseLayout>

<style is:global>
.php-manual {
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  line-height: 1.7;
  color: #333;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.dark .php-manual {
  color: #e5e5e5;
  background-color: #1a1a1a;
}

.php-manual :global(.navbar),
.php-manual :global(.navbar-fixed-top) {
  display: none !important;
}

.php-manual :global(h1.title) {
  font-size: 2rem;
  font-weight: 700;
  margin-bottom: 1.5rem;
  border-bottom: 2px solid #ea580c;
  padding-bottom: 0.5rem;
}

.php-manual :global(h2) {
  font-size: 1.5rem;
  font-weight: 600;
  margin-top: 2rem;
  margin-bottom: 1rem;
}

.php-manual :global(h3) {
  font-size: 1.25rem;
  font-weight: 600;
  margin-top: 1.5rem;
  margin-bottom: 0.75rem;
}

.php-manual :global(a) {
  color: #ea580c;
}

.php-manual :global(pre) {
  background: #fafafa;
  padding: 1rem;
  border-radius: 0.5rem;
  overflow-x: auto;
  font-size: 0.875rem;
}

.dark .php-manual :global(pre) {
  background: #262626;
}

.php-manual :global(code) {
  font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
}

.php-manual :global(table) {
  width: 100%;
  border-collapse: collapse;
  margin: 1rem 0;
}

.php-manual :global(th),
.php-manual :global(td) {
  padding: 0.5rem 0.75rem;
  border: 1px solid #e5e5e5;
}

.dark .php-manual :global(th),
.dark .php-manual :global(td) {
  border-color: #404040;
}

.php-manual :global(th) {
  background: #f5f5f5;
  font-weight: 600;
}

.dark .php-manual :global(th) {
  background: #262626;
}
</style>