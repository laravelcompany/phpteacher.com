---
import BaseLayout from "@layouts/BaseLayout.astro";
import booksData from "../../content/books-laravel.json";

export function getStaticPaths() {
  return booksData.books.map((book) => ({
    params: { id: book.id.toString() },
    props: { book },
  }));
}

const { book } = Astro.props;
const URL = Astro.url.href

const bookSchema = {
  '@context': 'https://schema.org',
  '@type': 'Book',
  '@id': URL,
  'url': URL,
  'name': book.title,
  'author': { '@type': 'Person', 'name': book.author },
  'datePublished': book.publication_date,
  'inLanguage': book.language || 'en',
  ...(book.isbn ? { 'isbn': book.isbn } : {}),
  ...(book.rating ? {
    'aggregateRating': {
      '@type': 'AggregateRating',
      'ratingValue': book.rating,
      'reviewCount': book.reviews || 0,
      'bestRating': 5,
    },
  } : {}),
  'offers': Object.entries(book.formats).filter(([, d]: any) => d.available).map(([format, details]: [string, any]) => ({
    '@type': 'Offer',
    'name': format,
    'price': details.price,
    'priceCurrency': details.currency,
    'availability': 'https://schema.org/InStock',
    ...(details.kindle_unlimited ? { 'eligiblePromotion': { '@type': 'Promotion', 'name': 'Kindle Unlimited' } } : {}),
  })),
}

const formatPrice = (price: number, currency: string) => {
  return new Intl.NumberFormat('en-GB', { style: 'currency', currency }).format(price);
};

const formatDate = (date: string) => {
  return new Date(date).toLocaleDateString('en-GB', { year: 'numeric', month: 'long' });
};

const getLevelColor = (level: string) => {
  if (level.includes('Beginner')) return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
  if (level.includes('Intermediate')) return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200';
  if (level.includes('Advanced')) return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
  return 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
};

const getBookColor = (id: number) => {
  const colors = [
    'from-orange-500 to-orange-600',
    'from-blue-500 to-blue-600',
    'from-green-500 to-green-600',
    'from-purple-500 to-purple-600',
    'from-pink-500 to-pink-600',
    'from-cyan-500 to-cyan-600',
    'from-rose-500 to-rose-600',
    'from-indigo-500 to-indigo-600',
    'from-amber-500 to-amber-600',
    'from-emerald-500 to-emerald-600',
  ];
  return colors[(id - 1) % colors.length];
};

const getPriceColor = (price: number) => {
  if (price < 10) return 'text-green-600 dark:text-green-400';
  if (price < 20) return 'text-yellow-600 dark:text-yellow-400';
  return 'text-red-600 dark:text-red-400';
};
---

<BaseLayout title={book.title} description={`Learn more about ${book.title} by ${book.author}`}>
  <script type="application/ld+json" set:html={JSON.stringify(bookSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': 'https://phpteacher.com' },
      { '@type': 'ListItem', 'position': 2, 'name': 'Laravel Books', 'item': 'https://phpteacher.com/books-laravel' },
      { '@type': 'ListItem', 'position': 3, 'name': book.title, 'item': URL },
    ],
  })} />
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto max-w-4xl">
      <a href="/books-laravel" class="inline-flex items-center text-blue-600 hover:text-blue-800 mb-6 transition-colors">
        <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
        </svg>
        Back to all books
      </a>
      
      <div class={`bg-white dark:bg-neutral-900 rounded-2xl shadow-lg overflow-hidden border-t-4 ${getBookColor(book.id).replace('from-', 'border-').replace(' to-', ' ').split(' ')[0]}`}>
        <div class={`h-32 bg-gradient-to-r ${getBookColor(book.id)}`}></div>
        
        <div class="px-8 pb-8">
          <div class="flex flex-col md:flex-row -mt-16 gap-8">
            <div class="shrink-0">
              <div class="w-40 h-56 bg-neutral-200 dark:bg-neutral-800 rounded-lg shadow-lg flex items-center justify-center border-4 border-white dark:border-neutral-900">
                <svg class="w-16 h-16 text-neutral-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
                </svg>
              </div>
            </div>
            
            <div class="flex-1 pt-4">
              <h1 class="text-3xl font-bold text-neutral-800 dark:text-neutral-100 mb-2">{book.title}</h1>
              <p class="text-lg text-neutral-600 dark:text-neutral-300 mb-4">by {book.author}</p>
              
              <div class="flex flex-wrap items-center gap-4 mb-4">
                {book.rating && (
                  <div class="flex items-center gap-2">
                    <div class="flex">
                      {[1, 2, 3, 4, 5].map((star) => (
                        <svg class={`w-5 h-5 ${star <= Math.round(book.rating) ? 'text-yellow-400' : 'text-neutral-300 dark:text-neutral-600'}`} fill="currentColor" viewBox="0 0 20 20">
                          <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                        </svg>
                      ))}
                    </div>
                    <span class="text-neutral-700 dark:text-neutral-300 font-medium">{book.rating}</span>
                    <span class="text-neutral-500 dark:text-neutral-400 text-sm">({book.reviews} reviews)</span>
                  </div>
                )}
                
                <span class={`px-3 py-1 rounded-full text-sm font-medium ${getLevelColor(book.level)}`}>
                  {book.level}
                </span>
                
                <span class="text-neutral-500 dark:text-neutral-400 text-sm">
                  {book.language}
                </span>
              </div>
              
              <p class="text-neutral-500 dark:text-neutral-400 text-sm">
                Published {formatDate(book.publication_date)}
              </p>
            </div>
          </div>
          
          <div class="mt-8">
            <h2 class="text-xl font-semibold text-neutral-800 dark:text-neutral-200 mb-4">Topics</h2>
            <div class="flex flex-wrap gap-2">
              {book.topics.map((topic) => (
                <span class="px-4 py-2 bg-neutral-100 dark:bg-neutral-800 text-neutral-700 dark:text-neutral-300 text-sm rounded-lg hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors cursor-default">
                  {topic}
                </span>
              ))}
            </div>
          </div>
          
          <div class="mt-8">
            <h2 class="text-xl font-semibold text-neutral-800 dark:text-neutral-200 mb-4">Available Formats</h2>
            <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {Object.entries(book.formats).map(([format, details]) => (
                <div class={`p-4 rounded-xl border-2 ${details.available ? 'border-green-200 dark:border-green-800 bg-green-50 dark:bg-green-900/20' : 'border-neutral-200 dark:border-neutral-700 bg-neutral-50 dark:bg-neutral-800'}`}>
                  <div class="flex items-center justify-between mb-2">
                    <span class={`text-lg font-semibold capitalize ${details.available ? 'text-neutral-800 dark:text-neutral-200' : 'text-neutral-400'}`}>{format}</span>
                    {details.kindle_unlimited && (
                      <span class="px-2 py-1 bg-yellow-100 dark:bg-yellow-900 text-yellow-800 dark:text-yellow-200 text-xs font-medium rounded">
                        Kindle Unlimited
                      </span>
                    )}
                  </div>
                  <div class="flex items-center justify-between">
                    <span class={`text-2xl font-bold ${details.available ? getPriceColor(details.price) : 'text-neutral-900 dark:text-neutral-100'}`}>
                      {details.available ? formatPrice(details.price, details.currency) : 'N/A'}
                    </span>
                    <span class={`text-sm font-medium ${details.available ? 'text-green-600' : 'text-red-500'}`}>
                      {details.available ? 'Available' : 'Out of stock'}
                    </span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>