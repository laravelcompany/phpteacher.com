---
import Image from '@components/ui/images/Image.astro'
import { SITE } from '@/config'

import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import BlogInsight from "@components/blog/BlogInsight.astro";
import footerBanner from '@images/logo2.svg'

const posts: CollectionEntry<"posts">[] = (await getCollection("posts")).sort(
    (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

const featuredPost = posts[0];
const recentPosts = posts.slice(1, 7);
---

<BaseLayout>
  <section class="relative overflow-hidden bg-gradient-to-br from-neutral-50 via-orange-50/30 to-neutral-100 dark:from-neutral-900 dark:via-orange-900/10 dark:to-neutral-800">
    <div class="absolute inset-0 bg-[url('data:image/svg+xml;base64,')] opacity-40 dark:opacity-20"></div>
    <div class="absolute top-20 right-10 w-72 h-72 bg-orange-400/10 rounded-full blur-3xl"></div>
    <div class="absolute bottom-10 left-10 w-96 h-96 bg-orange-300/10 rounded-full blur-3xl"></div>

    <!-- Decorative Code Snippets - Left -->
    <div class="absolute top-32 left-8 hidden xl:block opacity-30">
      <div class="font-mono text-xs leading-relaxed">
        <div class="text-neutral-400">&lt;?php</div>
        <div class="text-orange-500">function</div>
        <div class="text-neutral-600">  <span class="text-orange-400">greet</span>(<span class="text-yellow-500">$name</span>)</div>
        <div class="text-neutral-600">&#123;</div>
        <div class="text-neutral-600">  <span class="text-orange-400">echo</span> <span class="text-yellow-500">"Hello, $name"</span>;</div>
        <div class="text-neutral-600">&#125;</div>
      </div>
    </div>

    <div class="absolute top-1/2 -translate-y-1/2 left-8 hidden xl:block opacity-30">
      <div class="font-mono text-xs leading-relaxed">
        <div class="text-neutral-400">// PDO Query</div>
        <div class="text-neutral-600"><span class="text-orange-500">$stmt</span> = <span class="text-orange-400">$pdo</span>-><span class="text-orange-500">prepare</span>(</div>
        <div class="text-neutral-600">  <span class="text-yellow-500">"SELECT * FROM users"</span></div>
        <div class="text-neutral-600">);</div>
        <div class="text-neutral-600"><span class="text-orange-500">$stmt</span>-><span class="text-orange-500">execute</span>();</div>
      </div>
    </div>

    <div class="absolute bottom-32 left-8 hidden xl:block opacity-30">
      <div class="font-mono text-xs leading-relaxed">
        <div class="text-neutral-400">// Array map</div>
        <div class="text-neutral-600"><span class="text-orange-500">$result</span> = <span class="text-orange-400">array_map</span>(</div>
        <div class="text-neutral-600">  <span class="text-orange-500">fn</span>(<span class="text-yellow-500">$item</span>) => <span class="text-orange-500">$item</span> * <span class="text-yellow-500">2</span>,</div>
        <div class="text-neutral-600">  <span class="text-orange-500">$numbers</span></div>
        <div class="text-neutral-600">);</div>
      </div>
    </div>

    <!-- Decorative Code Snippets - Right -->
    <div class="absolute top-32 right-8 hidden xl:block opacity-30">
      <div class="font-mono text-xs leading-relaxed">
        <div class="text-neutral-400">// Class example</div>
        <div class="text-neutral-600"><span class="text-orange-500">class</span> <span class="text-orange-400">User</span></div>
        <div class="text-neutral-600">&#123;</div>
        <div class="text-neutral-600">  <span class="text-orange-500">public function</span> <span class="text-orange-400">__construct</span>(</div>
        <div class="text-neutral-600">    <span class="text-orange-500">private string</span> <span class="text-yellow-500">$name</span></div>
        <div class="text-neutral-600">  ) &#123;&#125;</div>
        <div class="text-neutral-600">&#125;</div>
      </div>
    </div>

    <div class="absolute top-1/2 translate-y-4 right-8 hidden xl:block opacity-30">
      <div class="font-mono text-xs leading-relaxed">
        <div class="text-neutral-400">// try-catch</div>
        <div class="text-neutral-600"><span class="text-orange-500">try</span> &#123;</div>
        <div class="text-neutral-600">  <span class="text-orange-500">throw</span> <span class="text-orange-400">new</span> <span class="text-orange-500">Exception</span>(<span class="text-yellow-500">"Error"</span>);</div>
        <div class="text-neutral-600">&#125; <span class="text-orange-500">catch</span> (<span class="text-orange-500">Exception</span> <span class="text-yellow-500">$e</span>) &#123;</div>
        <div class="text-neutral-600">  <span class="text-orange-400">echo</span> <span class="text-yellow-500">$e-&gt;getMessage()</span>;</div>
        <div class="text-neutral-600">&#125;</div>
      </div>
    </div>

    <div class="absolute bottom-24 right-8 hidden xl:block opacity-30">
      <div class="font-mono text-xs leading-relaxed">
        <div class="text-neutral-400">// Laravel Eloquent</div>
        <div class="text-neutral-600"><span class="text-orange-500">User</span>::<span class="text-orange-400">where</span>(</div>
        <div class="text-neutral-600">  <span class="text-yellow-500">'status'</span>, <span class="text-yellow-500">'active'</span></div>
        <div class="text-neutral-600">)-&gt;<span class="text-orange-400">latest</span>()-&gt;<span class="text-orange-400">get</span>();</div>
      </div>
    </div>

    <div class="grid px-4 py-16 mx-auto lg:gap-12 xl:gap-16 lg:py-24 lg:grid-cols-12 relative">
      <div class="mr-auto place-self-center lg:col-span-7">
        <div class="inline-flex items-center gap-2 px-4 py-2 mb-6 text-sm font-medium text-orange-700 bg-orange-100 rounded-full dark:bg-orange-900/40 dark:text-orange-300 ring-1 ring-orange-200/50 dark:ring-orange-700/30">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-orange-500 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-orange-500"></span>
          </span>
          Free PHP Learning Resources
        </div>
        <h1 class="max-w-3xl mb-6 text-4xl font-extrabold tracking-tight leading-none md:text-5xl xl:text-6xl dark:text-white">
          Master <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 via-orange-600 to-orange-700 dark:from-orange-400 dark:via-orange-500 dark:to-orange-600">PHP Programming</span> Like a Pro
        </h1>
        <p class="max-w-2xl mb-8 text-lg font-light text-neutral-600 lg:mb-10 dark:text-neutral-300">
          From beginner to advanced tutorials, framework deep dives, and real-world projects. 
         Level up your development career with practical, hands-on learning resources.
        </p>

        <!-- Popular Topics -->
        <div class="mb-6">
          <p class="text-sm text-neutral-500 dark:text-neutral-400 mb-3 font-medium">Popular Topics:</p>
          <div class="flex flex-wrap gap-2">
            <a href="/categories/" class="px-4 py-2 text-sm font-medium bg-white/80 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 rounded-full hover:bg-orange-50 dark:hover:bg-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition cursor-pointer text-neutral-700 dark:text-neutral-300">
              PHP Basics
            </a>
            <a href="/posts/" class="px-4 py-2 text-sm font-medium bg-white/80 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 rounded-full hover:bg-orange-50 dark:hover:bg-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition cursor-pointer text-neutral-700 dark:text-neutral-300">
              Laravel
            </a>
            <a href="/posts/" class="px-4 py-2 text-sm font-medium bg-white/80 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 rounded-full hover:bg-orange-50 dark:hover:bg-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition cursor-pointer text-neutral-700 dark:text-neutral-300">
              OOP
            </a>
            <a href="/posts/" class="px-4 py-2 text-sm font-medium bg-white/80 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 rounded-full hover:bg-orange-50 dark:hover:bg-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition cursor-pointer text-neutral-700 dark:text-neutral-300">
              Databases
            </a>
            <a href="/posts/" class="px-4 py-2 text-sm font-medium bg-white/80 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 rounded-full hover:bg-orange-50 dark:hover:bg-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition cursor-pointer text-neutral-700 dark:text-neutral-300">
              Testing
            </a>
            <a href="/posts/" class="px-4 py-2 text-sm font-medium bg-white/80 dark:bg-neutral-800/80 border border-neutral-200 dark:border-neutral-700 rounded-full hover:bg-orange-50 dark:hover:bg-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition cursor-pointer text-neutral-700 dark:text-neutral-300">
              APIs
            </a>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4">
          <a href="/posts" class="inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-gradient-to-r from-orange-500 to-orange-600 rounded-xl hover:from-orange-600 hover:to-orange-700 focus:ring-4 focus:ring-orange-300 dark:from-orange-600 dark:to-orange-700 dark:hover:from-orange-500 dark:hover:to-orange-600 dark:focus:ring-orange-800 transition-all duration-200 shadow-lg shadow-orange-500/25 hover:shadow-orange-500/40">
            Browse Articles
            <svg class="w-5 h-5 ml-2 -mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </a>
          <a href="/partners" class="inline-flex items-center justify-center px-8 py-4 text-base font-semibold text-neutral-700 bg-white border-2 border-neutral-200 rounded-xl hover:bg-neutral-50 hover:border-neutral-300 dark:text-white dark:border-neutral-600 dark:hover:bg-neutral-800 transition-all duration-200">
            Partner with Us
          </a>
        </div>

        <div class="flex items-center gap-8 mt-10 text-sm text-neutral-500 dark:text-neutral-400">
          <div class="flex items-center gap-3">
            <div class="flex -space-x-2">
              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-orange-400 to-orange-600 border-2 border-white dark:border-neutral-800"></div>
              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-orange-300 to-orange-500 border-2 border-white dark:border-neutral-800"></div>
              <div class="w-8 h-8 rounded-full bg-gradient-to-br from-orange-200 to-orange-400 border-2 border-white dark:border-neutral-800"></div>
            </div>
            <span class="font-medium">5,000+ Readers</span>
          </div>
          <div class="hidden sm:flex items-center gap-2">
            <svg class="w-5 h-5 text-orange-500" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path></svg>
            <span class="font-medium">Weekly Updates</span>
          </div>
        </div>
      </div>
      <div class="hidden lg:mt-0 lg:col-span-5 lg:flex relative">
        <div class="absolute -inset-6 bg-gradient-to-r from-orange-400/20 via-orange-500/20 to-orange-600/20 rounded-full blur-3xl animate-pulse"></div>
        <Image
          src={footerBanner}
          alt={SITE.title}
          class="h-full w-full object-cover object-center relative z-10"
          draggable="false"
          loading="eager"
          disableBlur={true}
        />
      </div>
    </div>
  </section>

  <!-- What You'll Learn Section -->
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8 bg-white dark:bg-neutral-900">
    <div class="max-w-[85rem] mx-auto">
      <div class="text-center mb-12">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800 dark:text-neutral-200 mb-4">What You'll Learn</h2>
        <p class="text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
          Comprehensive PHP resources covering everything from the fundamentals to advanced framework concepts.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        <div class="bg-neutral-50 dark:bg-neutral-800 rounded-2xl p-8 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition-all duration-300 group">
          <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/40 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-2">PHP Basics & Syntax</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">Variables, data types, control structures, functions, and modern PHP features.</p>
        </div>

        <div class="bg-neutral-50 dark:bg-neutral-800 rounded-2xl p-8 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition-all duration-300 group">
          <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/40 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-2">OOP & Design Patterns</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">Classes, inheritance, interfaces, traits, and proven design patterns in PHP.</p>
        </div>

        <div class="bg-neutral-50 dark:bg-neutral-800 rounded-2xl p-8 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition-all duration-300 group">
          <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/40 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-2">Databases & SQL</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">PDO, MySQL, query optimization, Eloquent ORM, and database design patterns.</p>
        </div>

        <div class="bg-neutral-50 dark:bg-neutral-800 rounded-2xl p-8 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition-all duration-300 group">
          <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/40 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-2">Testing & TDD</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">PHPUnit, Pest, test-driven development, mocking, and continuous integration.</p>
        </div>

        <div class="bg-neutral-50 dark:bg-neutral-800 rounded-2xl p-8 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition-all duration-300 group">
          <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/40 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 15a4 4 0 004 4h9a5 5 0 10-.1-9.999 5.002 5.002 0 10-9.78 2.096A4.001 4.001 0 003 15z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-2">APIs & Integration</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">RESTful APIs, GraphQL, HTTP clients, authentication, and third-party services.</p>
        </div>

        <div class="bg-neutral-50 dark:bg-neutral-800 rounded-2xl p-8 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition-all duration-300 group">
          <div class="w-12 h-12 bg-orange-100 dark:bg-orange-900/40 rounded-xl flex items-center justify-center mb-5 group-hover:scale-110 transition-transform">
            <svg class="w-6 h-6 text-orange-600 dark:text-orange-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
            </svg>
          </div>
          <h3 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-2">Security & Best Practices</h3>
          <p class="text-sm text-neutral-600 dark:text-neutral-400">Authentication, authorization, validation, XSS/CSRF prevention, and secure coding.</p>
        </div>
      </div>
    </div>
  </section>

  {featuredPost && (
    <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8">
      <div class="mb-8">
        <h2 class="text-2xl font-bold text-neutral-800 dark:text-neutral-200">Featured Article</h2>
      </div>
      <a href={`/posts/${featuredPost.slug}/`} class="group relative grid grid-cols-1 md:grid-cols-2 gap-0 md:gap-8 overflow-hidden rounded-2xl bg-white dark:bg-neutral-900 shadow-lg hover:shadow-xl transition-all duration-300" data-astro-prefetch>
        <div class="relative aspect-[16/9] md:aspect-auto md:min-h-[320px] overflow-hidden">
          <Image
            class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
            src={featuredPost.data.banner}
            alt={featuredPost.data.title}
            format="avif"
            loading="eager"
            width="850"
            height="440"
          />
          <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent md:hidden"></div>
        </div>
        <div class="p-6 md:p-10 flex flex-col justify-center">
          <div class="flex items-center gap-3 mb-4">
            <span class="px-3 py-1 text-xs font-semibold text-white bg-orange-600 rounded-full">
              Featured
            </span>
            <time class="text-sm text-neutral-500 dark:text-neutral-400">
              {featuredPost.data.pubDate.toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}
            </time>
          </div>
          <h3 class="text-2xl md:text-3xl font-bold text-neutral-800 dark:text-white mb-4 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
            {featuredPost.data.title}
          </h3>
          <p class="text-neutral-600 dark:text-neutral-400 mb-6 line-clamp-3">
            {featuredPost.data.description}
          </p>
          <div class="inline-flex items-center gap-2 font-medium text-orange-600 dark:text-orange-400 group-hover:gap-3 transition-all">
            Read Article
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
          </div>
        </div>
      </a>
    </section>
  )}

  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto mb-10 max-w-2xl text-center lg:mb-14">
      <h2 class="text-3xl font-bold text-neutral-800 dark:text-neutral-200 md:text-4xl md:leading-tight">
        Latest Articles
      </h2>
      <p class="mt-2 text-neutral-600 dark:text-neutral-400">
        Fresh tutorials, guides, and insights to help you grow as a developer.
      </p>
    </div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {recentPosts.map((b) => <BlogInsight blog={b} />)}
    </div>
    <div class="mt-12 text-center">
      <a href="/posts" class="inline-flex items-center justify-center px-6 py-3 text-base font-medium text-neutral-700 bg-white border border-neutral-300 rounded-lg hover:bg-neutral-50 dark:text-white dark:border-neutral-600 dark:hover:bg-neutral-800 transition-all duration-200">
        View All Articles
        <svg class="w-5 h-5 ml-2 -mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="py-16 lg:py-24 px-4 sm:px-6 lg:px-8 bg-gradient-to-b from-neutral-100 to-neutral-50 dark:from-neutral-800 dark:to-neutral-900">
    <div class="max-w-[85rem] mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl lg:text-4xl font-bold text-neutral-800 dark:text-neutral-200 mb-4">
          Loved by the Community
        </h2>
        <p class="text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto">
          Real feedback from developers who use our resources to level up their PHP skills.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-5xl mx-auto">
        <div class="bg-white dark:bg-neutral-800 rounded-2xl p-8 border border-neutral-200 dark:border-neutral-700 hover:border-orange-300 dark:hover:border-orange-600 transition-all duration-300">
          <p class="text-neutral-600 dark:text-neutral-400 text-sm leading-relaxed mb-6">
            "The tutorials here are incredibly practical. I went from knowing basic PHP to building full Laravel applications in just a few months. The step-by-step approach is exactly what I needed."
          </p>
          <div class="flex items-center gap-3">
            <div class="w-10 h-10 bg-gradient-to-br from-orange-400 to-orange-600 rounded-full flex items-center justify-center text-white font-bold text-sm">
              JD
            </div>
            <div>
