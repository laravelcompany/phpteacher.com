---
import { sortedBlogQa } from '@support/blog-qa'
import BaseLayout from '@layouts/BaseLayout.astro'
import BlogQaCard from '@components/blog/BlogQaCard.astro'
import Pagination from '@components/blog/Pagination.astro'

const POSTS_PER_PAGE = 24

export async function getStaticPaths() {
    const POSTS_PER_PAGE = 24
    const allPosts = sortedBlogQa()
    const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE)
    const pages = []
    for (let page = 2; page <= totalPages; page++) {
        // Pass only this page's slice as props - serializing the whole
        // collection into every route's props blows the build heap.
        pages.push({
            params: { page: String(page) },
            props: {
                currentPage: page,
                totalPages,
                pagePosts: allPosts.slice((page - 1) * POSTS_PER_PAGE, page * POSTS_PER_PAGE).map(p => ({
                    id: p.id,
                    title: p.title,
                    excerpt: p.excerpt,
                    date: p.date,
                    category: p.category,
                    banner: p.banner || p.image,
                })),
            },
        })
    }
    return pages
}

type PagePost = { id: string; title: string; excerpt: string; date: string; category?: string; banner?: string | null }

type Props = {
    currentPage: number
    totalPages: number
    pagePosts: PagePost[]
}

const { currentPage, totalPages, pagePosts } = Astro.props

const description = `PHP and Laravel articles and Q&A - page ${currentPage} of ${totalPages}.`
---

<BaseLayout title={`Blog - Page ${currentPage}`} description={description}>
    <section class="max-w-8xl mx-auto px-4 pb-12 pt-28">
        <nav class="mb-8 flex items-center gap-2 text-sm text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="transition-colors hover:text-white">Home</a>
            <span>/</span>
            <a href="/blog/" class="transition-colors hover:text-white">Blog</a>
            <span>/</span>
            <span class="text-white">Page {currentPage}</span>
        </nav>

        <h1 class="block text-balance text-3xl font-bold tracking-tight text-neutral-800 dark:text-neutral-200 md:text-4xl">Blog - page {currentPage} of {totalPages}</h1>

        <div class="mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {pagePosts.map(post => (
                <BlogQaCard id={post.id} title={post.title} excerpt={post.excerpt} date={post.date} category={post.category} banner={post.banner} />
            ))}
        </div>

        <div class="mt-12">
            <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/blog/" />
        </div>
    </section>
</BaseLayout>
