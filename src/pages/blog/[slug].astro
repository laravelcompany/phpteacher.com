---
import { existsSync } from 'node:fs'
import { loadBlogQa } from '@support/blog-qa'
import BaseLayout from '@layouts/BaseLayout.astro'
import { SITE } from '@/config'
import { marked } from 'marked'

marked.setOptions({
    gfm: true,
    breaks: true,
})

export async function getStaticPaths() {
    // Cloudflare Pages builds set SKIP_BLOG_POST_PAGES=1: the ~16k post
    // pages would exceed the Pages 20k-file deploy cap. They are served by
    // the Worker from KV instead (src/worker.js); a full local build renders
    // them and scripts/extract-blog-posts.mjs ships them to KV.
    if (process.env.SKIP_BLOG_POST_PAGES === '1') return []
    let posts = loadBlogQa()
    // Sandboxes with short command limits can render the posts in slices:
    // BLOG_SLICE=2/8 renders only posts whose index mod 8 is 2. The slices'
    // post HTML is harvested per run and assembled into kv-bulk afterwards
    // (scripts/assemble-kv-bulk.mjs).
    const slice = process.env.BLOG_SLICE
    if (slice) {
        const [i, n] = slice.split('/').map(Number)
        posts = posts.filter((_, idx) => idx % n === i)
    }
    return posts.map(post => ({
        params: { slug: post.id },
        props: { post },
    }))
}

const { post } = Astro.props
const data = post

function isMarkdown(content: string): boolean {
    const trimmed = content.trimStart()
    if (trimmed.startsWith('<')) return false
    return /(^#{1,6}\s|^\*\*|^-\s|^\d+\.\s|```|^\[.*\]\(|^>\s|\|.+\|)/m.test(trimmed)
}

// Many imported posts embed generator labels in the content itself: a
// leading "Title: ..." line (a duplicate of the post title, already the h1)
// and a bare "Body:" marker line. Strip both.
function stripContentLabels(content: string): string {
    return content
        .replace(/^\s*Title:[^\n]*(\r?\n)?/, '')
        .replace(/^Body:\s*$/gm, '')
        .trimStart()
}

const cleanContent = stripContentLabels(data.content)
const cleanExcerpt = data.excerpt
    .replace(/^Title:\s*/, '')
    .replace(/\s*Body:\s*/, ' ')
    .trim()
const renderedContent = isMarkdown(cleanContent) ? (marked.parse(cleanContent) as string) : cleanContent

// The shared author avatar only exists on some network sites; render it only
// when this site actually ships the file.
const avatarSrc =
    data.authorAvatar && existsSync(`public${data.authorAvatar}`) ? data.authorAvatar : null

function formatDate(d: string): string {
    const t = new Date(d)
    if (isNaN(t.valueOf())) return d
    return t.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
}

// Google truncates meta descriptions around 155-160 characters.
function truncateDescription(text: string, max = 157): string {
    if (text.length <= 160) return text
    const cut = text.slice(0, max)
    const lastSpace = cut.lastIndexOf(' ')
    return (lastSpace > 80 ? cut.slice(0, lastSpace) : cut).trimEnd() + '…'
}

const description = truncateDescription(cleanExcerpt)
const postUrl = new URL(`/blog/${post.id}/`, SITE.url).href
const isoDate = (() => {
    const t = new Date(data.date)
    return isNaN(t.valueOf()) ? data.date : t.toISOString()
})()
const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description,
    datePublished: isoDate,
    author: {
        '@type': 'Person',
        name: data.author,
    },
    mainEntityOfPage: postUrl,
}
---

<BaseLayout
    title={data.title}
    description={description}
    structuredData={articleSchema}
    article={true}
    publishedTime={isoDate}
    author={data.author}
>
    <article class="mx-auto max-w-3xl px-4 pt-28 pb-16 sm:px-6">
        <nav class="mb-8 flex items-center gap-2 text-sm text-neutral-400" aria-label="Breadcrumb">
            <a href="/" class="transition-colors hover:text-white">Home</a>
            <span>/</span>
            <a href="/blog/" class="transition-colors hover:text-white">Blog</a>
            <span>/</span>
            <span class="truncate text-white">{data.title}</span>
        </nav>

        <p class="text-xs font-semibold uppercase tracking-widest text-orange-400">
            Blog · {formatDate(data.date)}
        </p>
        <h1 class="mt-3 text-3xl font-extrabold leading-tight tracking-tight text-white sm:text-4xl">
            {data.title}
        </h1>

        <div class="mt-6 flex items-center gap-3 border-b border-neutral-800 pb-6">
            {avatarSrc && (
                <img src={avatarSrc} alt={data.author} class="h-10 w-10 rounded-full object-cover" loading="lazy" />
            )}
            <div>
                <p class="text-sm font-bold text-white">{data.author}</p>
                <p class="text-xs text-neutral-400">{data.authorRole}</p>
            </div>
        </div>

        <div class="blog-content mt-8 text-neutral-300" set:html={renderedContent} />
    </article>
</BaseLayout>

<style is:global>
    .blog-content h1,
    .blog-content h2,
    .blog-content h3,
    .blog-content h4 {
        color: #fff;
        font-weight: 800;
        margin-top: 2rem;
        margin-bottom: 0.75rem;
        line-height: 1.25;
    }
    .blog-content h2 { font-size: 1.5rem; }
    .blog-content h3 { font-size: 1.25rem; }
    .blog-content p { margin-bottom: 1rem; line-height: 1.75; }
    .blog-content ul,
    .blog-content ol {
        margin-bottom: 1rem;
        padding-left: 1.5rem;
        line-height: 1.75;
    }
    .blog-content ul { list-style: disc; }
    .blog-content ol { list-style: decimal; }
    .blog-content li { margin-bottom: 0.25rem; }
    .blog-content a {
        color: #fb923c;
        text-decoration: underline;
        text-underline-offset: 2px;
    }
    .blog-content a:hover { color: #fdba74; }
    .blog-content pre {
        background: rgba(0, 0, 0, 0.45);
        border: 1px solid rgba(139, 92, 246, 0.2);
        border-radius: 0.75rem;
        padding: 1rem;
        overflow-x: auto;
        margin-bottom: 1.25rem;
        font-size: 0.85rem;
        line-height: 1.6;
    }
    .blog-content code {
        font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
        font-size: 0.85em;
    }
    .blog-content p code,
    .blog-content li code {
        background: rgba(139, 92, 246, 0.15);
        border-radius: 0.35rem;
        padding: 0.1rem 0.35rem;
    }
    .blog-content pre code {
        background: none;
        padding: 0;
    }
    .blog-content blockquote {
        border-left: 3px solid #7c3aed;
        padding-left: 1rem;
        margin-bottom: 1rem;
        color: rgba(255, 255, 255, 0.65);
        font-style: italic;
    }
    .blog-content table {
        width: 100%;
        border-collapse: collapse;
        margin-bottom: 1.25rem;
        font-size: 0.9rem;
    }
    .blog-content th,
    .blog-content td {
        border: 1px solid rgba(255, 255, 255, 0.15);
        padding: 0.5rem 0.75rem;
        text-align: left;
    }
    .blog-content img {
        max-width: 100%;
        height: auto;
        border-radius: 0.75rem;
    }
    .blog-content hr {
        border-color: rgba(255, 255, 255, 0.1);
        margin: 2rem 0;
    }
</style>
