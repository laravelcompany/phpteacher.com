---
import { existsSync } from 'node:fs'
import { loadBlogQa } from '@support/blog-qa'
import BaseLayout from '@layouts/BaseLayout.astro'
import BlogComments from '@components/blog/BlogComments'
import BlogLeadscaptainPopup from '@components/BlogLeadscaptainPopup.astro'
import Image from '@components/ui/images/Image.astro'
import { formatDateTime } from '@support/time'
import { SITE, Settings } from '@/config'
import { marked } from 'marked'

marked.setOptions({
    gfm: true,
    breaks: true,
})

export async function getStaticPaths() {
    // Cloudflare Pages builds set SKIP_BLOG_POST_PAGES=1: the ~10k post
    // pages would exceed the Pages 20k-file deploy cap. They are served by
    // the Worker from KV instead (src/worker.js); a full local build renders
    // them and scripts/extract-blog-posts.mjs ships them to KV.
    if (process.env.SKIP_BLOG_POST_PAGES === '1') return []
    let posts = loadBlogQa()
    // Sandboxes with short command limits can render the posts in slices:
    // BLOG_SLICE=2/8 renders only posts whose index mod 8 is 2. The slices'
    // post HTML is harvested per run and assembled into kv-bulk afterwards
    // (scripts/assemble-kv-bulk.mjs).
    const slice = process.env.BLOG_SLICE
    if (slice) {
        const [i, n] = slice.split('/').map(Number)
        posts = posts.filter((_, idx) => idx % n === i)
    }
    return posts.map(post => ({
        params: { slug: post.id },
        props: { post },
    }))
}

const { post } = Astro.props
const data = post

function isMarkdown(content: string): boolean {
    const trimmed = content.trimStart()
    if (trimmed.startsWith('<')) return false
    return /(^#{1,6}\s|^\*\*|^-\s|^\d+\.\s|```|^\[.*\]\(|^>\s|\|.+\|)/m.test(trimmed)
}

// Many imported posts embed generator labels in the content itself: a
// leading "Title: ..." line (a duplicate of the post title, already the h1)
// and a bare "Body:" marker line. Strip both.
function stripContentLabels(content: string): string {
    return content
        .replace(/^\s*Title:[^\n]*(\r?\n)?/, '')
        .replace(/^Body:\s*$/gm, '')
        .trimStart()
}

const cleanContent = stripContentLabels(data.content)
const cleanExcerpt = (data.excerpt || data.description || '')
    .replace(/^Title:\s*/, '')
    .replace(/\s*Body:\s*/, ' ')
    .replace(/^#+\s*/gm, '')
    .trim()
const renderedContent = isMarkdown(cleanContent) ? (marked.parse(cleanContent) as string) : cleanContent

const minutesRead = (() => {
    const words = cleanContent.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length
    const minutes = Math.max(1, Math.round(words / 200))
    return `${minutes} min read`
})()

// The shared author avatar only exists on some network sites; render it only
// when this site actually ships the file.
const avatarSrc =
    data.authorAvatar && existsSync(`public${data.authorAvatar}`) ? data.authorAvatar : null

function formatDate(d: string): string {
    const t = new Date(d)
    if (isNaN(t.valueOf())) return d
    return t.toLocaleDateString('en-GB', { year: 'numeric', month: 'long', day: 'numeric' })
}

// Google truncates meta descriptions around 155-160 characters.
function truncateDescription(text: string, max = 157): string {
    if (text.length <= 160) return text
    const cut = text.slice(0, max)
    const lastSpace = cut.lastIndexOf(' ')
    return (lastSpace > 80 ? cut.slice(0, lastSpace) : cut).trimEnd() + '…'
}

const description = truncateDescription(cleanExcerpt)
const postUrl = new URL(`/blog/${post.id}/`, SITE.url).href
const isoDate = (() => {
    if (!data.date) return undefined
    const t = new Date(data.date)
    return isNaN(t.valueOf()) ? data.date : t.toISOString()
})()
const bannerSrc = data.banner || data.image || '/logo.svg'
const bannerUrl = bannerSrc.startsWith('http') ? bannerSrc : Astro.url.origin + bannerSrc
const tags: string[] = Array.isArray(data.tags) ? data.tags : []
const articleSchema = {
    '@context': 'https://schema.org',
    '@type': 'BlogPosting',
    headline: data.title,
    description,
    image: [bannerUrl],
    datePublished: isoDate,
    author: {
        '@type': 'Person',
        name: data.author,
    },
    mainEntityOfPage: postUrl,
}
---

<BaseLayout
    title={data.title}
    description={description}
    ogImage={bannerUrl}
    structuredData={articleSchema}
    article={true}
    publishedTime={isoDate}
    author={data.author}
>
    <script type="application/ld+json" set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'BreadcrumbList',
        'itemListElement': [
            { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE.url },
            { '@type': 'ListItem', 'position': 2, 'name': 'Blog', 'item': SITE.url + '/blog/' },
            { '@type': 'ListItem', 'position': 3, 'name': data.title, 'item': postUrl },
        ],
    })} />
    <ins class="adsbygoogle"
    style="display:block; text-align:center;"
    data-ad-layout="in-article"
    data-ad-format="fluid"
    data-ad-client="ca-pub-6836700493760647"
    data-ad-slot="8558646757"></ins>
    <script>
        (adsbygoogle = window.adsbygoogle || []).push({});
    </script>
    <div class="mx-auto max-w-6xl px-4 pb-12 pt-8 sm:px-6 lg:px-8 lg:pt-12">
        <div class="relative w-full">
            <div class="shadow-none sm:shadow-sm mt-4 sm:mt-0">
                <Image
                    class="w-full object-cover rounded-tl-sm rounded-tr-sm max-h-[600px]"
                    src={bannerSrc}
                    alt={data.title}
                    draggable="false"
                    format="avif"
                    loading="lazy"
                    width={1200}
                    height={600}
                />
                <div class="sm:dark:bg-neutral-900/30 sm:bg-neutral-100 px-0 sm:px-6 md:px-10 lg:px-14 py-6">
                    <div class="mb-10">
                        <nav class="mb-6 flex items-center gap-2 text-sm text-neutral-400" aria-label="Breadcrumb">
                            <a href="/" class="transition-colors hover:text-white">Home</a>
                            <span>/</span>
                            <a href="/blog/" class="transition-colors hover:text-white">Blog</a>
                            <span>/</span>
                            <span class="truncate text-white">{data.title}</span>
                        </nav>
                        <h1 class="block text-balance text-3xl font-bold tracking-tight text-neutral-800 dark:text-neutral-300 md:text-4xl lg:text-5xl">
                            {data.title}
                        </h1>
                        <ol class="flex items-center whitespace-nowrap mt-2">
                            <li class="inline-flex items-center">
                                <span class="flex items-center text-sm text-orange-400">
                                    {data.category ? `Blog · ${data.category}` : 'Blog'}
                                </span>
                                <svg
                                    class="flex-shrink-0 size-5 text-neutral-500 dark:text-neutral-600 mx-2"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true"
                                >
                                    <path d="M6 13L10 3" stroke="currentColor" stroke-linecap="round"></path>
                                </svg>
                            </li>
                            {data.date && <li class="inline-flex items-center text-sm text-neutral-500 dark:text-neutral-500">
                                {formatDate(data.date)}
                                <svg
                                    class="flex-shrink-0 size-5 text-neutral-500 dark:text-neutral-600 mx-2"
                                    width="16"
                                    height="16"
                                    viewBox="0 0 16 16"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                    aria-hidden="true"
                                >
                                    <path d="M6 13L10 3" stroke="currentColor" stroke-linecap="round"></path>
                                </svg>
                            </li>}
                            <li
                                class="inline-flex items-center text-sm text-neutral-500 dark:text-neutral-500"
                                aria-current="page"
                            >
                                {minutesRead}
                            </li>
                        </ol>
                        <div class="mt-6 flex items-center gap-3">
                            {avatarSrc && (
                                <img src={avatarSrc} alt={data.author} class="h-10 w-10 rounded-full object-cover" loading="lazy" />
                            )}
                            <div>
                                <p class="text-sm font-bold text-neutral-800 dark:text-white">{data.author}</p>
                                <p class="text-xs text-neutral-500 dark:text-neutral-400">{data.authorRole}</p>
                            </div>
                        </div>
                    </div>

                    <article class="prose prose-blog sm:prose-lg dark:prose-invert max-w-none text-justify" set:html={renderedContent} />

                    {tags.length > 0 && (
                        <div class="mt-10 md:mt-14 mx-auto grid max-w-screen-lg gap-y-5 sm:flex sm:items-center sm:justify-between sm:gap-y-0">
                            <div class="flex flex-wrap gap-x-2 gap-y-1 sm:flex-nowrap sm:items-center sm:gap-y-0">
                                {tags.map((tag: string) => (
                                    <span class="inline-flex items-center gap-x-1.5 rounded-lg bg-neutral-400/30 px-3 py-1.5 text-xs font-medium text-neutral-700 outline-none dark:bg-neutral-700/60 dark:text-neutral-300">
                                        {tag}
                                    </span>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            </div>
            {
                Settings.Comment.enable && (
                    <div class="my-10">
                        <BlogComments client:only="react" />
                    </div>
                )
            }
        </div>
    </div>
    <BlogLeadscaptainPopup />
</BaseLayout>
