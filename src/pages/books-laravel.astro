---
import BaseLayout from "@layouts/BaseLayout.astro";
import booksData from "../content/books-laravel.json";
import { SITE } from '@/config';

const books = booksData.books;
const metadata = booksData.metadata;

const formatPrice = (price: number, currency: string) => {
  return new Intl.NumberFormat('en-GB', { style: 'currency', currency }).format(price);
};

const getLevelColor = (level: string) => {
  if (level.includes('Beginner')) return 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200';
  if (level.includes('Intermediate')) return 'bg-yellow-100 text-yellow-800 dark:bg-yellow-900 dark:text-yellow-200';
  if (level.includes('Advanced')) return 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200';
  return 'bg-blue-100 text-blue-800 dark:bg-blue-900 dark:text-blue-200';
};

const getBookColor = (id: number) => {
  const colors = [
    'from-orange-400 to-orange-600',    // Orange
    'from-blue-400 to-blue-600',         // Blue
    'from-green-400 to-green-600',       // Green
    'from-purple-400 to-purple-600',     // Purple
    'from-pink-400 to-pink-600',        // Pink
    'from-cyan-400 to-cyan-600',        // Cyan
    'from-rose-400 to-rose-600',        // Rose
    'from-indigo-400 to-indigo-600',   // Indigo
    'from-amber-400 to-amber-600',      // Amber
    'from-emerald-400 to-emerald-600',  // Emerald
  ];
  return colors[(id - 1) % colors.length];
};

const getPriceLabel = (price: number) => {
  if (price < 10) return 'text-green-600';
  if (price < 20) return 'text-yellow-600';
  return 'text-red-600';
};

const isNewBook = (date: string) => {
  const pubDate = new Date(date);
  const sixMonthsAgo = new Date();
  sixMonthsAgo.setMonth(sixMonthsAgo.getMonth() - 6);
  return pubDate > sixMonthsAgo;
};

const getFirstFormat = (formats: any) => {
  const keys = Object.keys(formats);
  return keys.length > 0 ? formats[keys[0]] : null;
};

const itemListStructuredData = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "itemListElement": books.map((book, index) => {
    const firstFormat = getFirstFormat(book.formats);
    return {
      "@type": "ListItem",
      "position": index + 1,
      "item": {
        "@type": "Book",
        "name": book.title,
        "author": { "@type": "Person", "name": book.author },
        "datePublished": book.publication_date,
        "inLanguage": "en",
        "offers": firstFormat ? {
          "@type": "Offer",
          "priceCurrency": firstFormat.currency,
          "price": firstFormat.price,
        } : undefined,
      }
    };
  })
};
---

<BaseLayout title="Laravel Books" description="A curated list of Laravel books for developers of all levels">
  <!-- BreadcrumbList -->
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    'itemListElement': [
      { '@type': 'ListItem', 'position': 1, 'name': 'Home', 'item': SITE.url },
      { '@type': 'ListItem', 'position': 2, 'name': 'Laravel Books', 'item': Astro.url.href },
    ],
  })} />
  <!-- Books structured data -->
  <script type="application/ld+json" set:html={JSON.stringify(itemListStructuredData)} />
  <section class="mx-auto max-w-[85rem] px-4 py-10 sm:px-6 lg:px-8 lg:py-14">
    <div class="mx-auto mb-8 max-w-3xl text-center">
      <h1 class="text-4xl font-bold text-neutral-800 dark:text-neutral-100 mb-4">
        Laravel Books Collection
      </h1>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 mb-4">
        Discover the best Laravel books to enhance your skills, from beginner to advanced levels.
      </p>
      <div class="flex items-center justify-center gap-4 text-sm text-neutral-500 dark:text-neutral-400">
        <span class="flex items-center gap-1">
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />
          </svg>
          {metadata.total_books} books
        </span>
        <span>|</span>
        <span>Last updated: {metadata.last_updated}</span>
      </div>
    </div>

    <div class="mx-auto max-w-4xl mb-12">
      <div class="prose prose-blog sm:prose-lg dark:prose-invert max-w-none text-justify">
        <p>
          Laravel has become the most popular PHP framework for web development, and mastering it requires continuous learning. While online tutorials and video courses are valuable, Laravel books offer structured, in-depth knowledge that helps you build a solid foundation. Whether you are just starting with <a href="/books/3">Laravel 12 for Beginners</a> or looking to master advanced concepts, this curated collection covers every skill level.
        </p>
        <p>
          Reading comprehensive Laravel books allows you to learn at your own pace, revisit complex topics, and gain insights from experienced authors who have built real-world applications. From clean architecture and testing to building multi-vendor marketplaces and SaaS platforms, these books cover the full spectrum of modern PHP development. Explore our <a href="/posts/">PHP tutorials</a> and resources to complement your reading journey.
        </p>
      </div>
    </div>
    
    <div class="grid gap-6 sm:grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
      {books.map((book) => (
        <a href={`/books/${book.id}`} class="group block bg-white dark:bg-neutral-900 rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden border border-transparent hover:border-orange-300 dark:hover:border-orange-700">
          <div class={`h-40 bg-gradient-to-br ${getBookColor(book.id)} flex items-center justify-center relative`}>
            {isNewBook(book.publication_date) && (
              <span class="absolute top-3 right-3 px-2 py-1 bg-white/90 dark:bg-black/50 text-orange-600 dark:text-orange-400 text-xs font-bold rounded-full shadow">
                NEW
              </span>
            )}
            <img src="/logo.svg" alt="" class="w-24 h-24 text-white/50" />
          </div>
          
          <div class="p-5">
            <h2 class="text-lg font-bold text-neutral-800 dark:text-neutral-200 mb-2 line-clamp-2 group-hover:text-orange-600 dark:group-hover:text-orange-400 transition-colors">
              {book.title}
            </h2>
            
            <p class="text-sm text-neutral-600 dark:text-neutral-400 mb-3">{book.author}</p>
            
            <div class="flex items-center gap-2 mb-3">
              {book.rating && (
                <div class="flex items-center gap-1">
                  <svg class="w-4 h-4 text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z" />
                  </svg>
                  <span class="text-sm font-medium text-neutral-700 dark:text-neutral-300">{book.rating}</span>
                </div>
              )}
              <span class={`px-2 py-0.5 text-xs font-medium rounded-full ${getLevelColor(book.level)}`}>
                {book.level.split(' ')[0]}
              </span>
            </div>
            
            <div class="flex items-center justify-between pt-3 border-t border-neutral-200 dark:border-neutral-700">
              <span class="text-sm font-semibold text-neutral-600 dark:text-neutral-400">From</span>
              <div class="flex flex-wrap gap-1">
                {Object.entries(book.formats).slice(0, 2).map(([format, details]) => (
                  <span class={`text-sm font-bold ${getPriceLabel(details.price)}`}>
                    {formatPrice(details.price, details.currency)}
                  </span>
                ))}
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    <div class="mx-auto max-w-4xl mt-16">
      <div class="prose prose-blog sm:prose-lg dark:prose-invert max-w-none text-justify">
        <h2>Why Learn Laravel from Books?</h2>
        <p>
          Laravel powers some of the most sophisticated web applications on the internet, from SaaS platforms to e-commerce marketplaces. While the official documentation is excellent, Laravel books provide a structured learning path that builds concepts progressively. Authors like <strong>Matt Stauffer</strong>, whose <a href="/books/1">Laravel: Up & Running</a> remains one of the most recommended resources, distil years of practical experience into digestible chapters that you can work through systematically.
        </p>
        <p>
          Books offer a depth that short-form content cannot match. They cover not just the "how" but the "why" behind architectural decisions, design patterns, and best practices. For developers looking to advance their careers, investing time in comprehensive reading materials often yields better long-term results than skimming through disconnected tutorials.
        </p>

        <h2>Best Laravel Books for Beginners</h2>
        <p>
          If you are new to Laravel, choosing the right starting point is crucial. <a href="/books/3">Laravel 12 for Beginners & Beyond</a> by Roderick A. Reeves provides a gentle introduction to the framework while also covering clean architecture principles. For an even more hands-on approach, <a href="/books/12">Laravel 12 for Beginners: Build Modern Web Apps with PHP the Easy Way</a> by Haider Koele focuses on practical project building from day one.
        </p>
        <p>
          <a href="/books/17">Mastering Laravel for Beginners: A Step-by-Step Guide to Modern PHP Development</a> by Dr. Quinn Miles breaks down complex topics into manageable lessons, making it ideal for self-taught developers. <a href="/books/15">Laravel Web Development: 68 Things Beginners Need to Know</a> by Sarah Williams, Emily Davis, and colleagues offers a concise reference for common patterns and pitfalls. For those who learn best by doing, <a href="/books/4">Laravel for the rest of us</a> by Pete Heslop takes a practical, no-nonsense approach to building real applications.
        </p>

        <h2>Intermediate Laravel Books</h2>
        <p>
          Once you have the basics down, intermediate books help you level up your architecture skills and understanding of the framework's deeper features. <a href="/books/1">Laravel: Up & Running</a> by Matt Stauffer is the definitive guide that bridges beginner and intermediate knowledge, covering everything from Eloquent ORM to the service container. <a href="/books/9">Practical Laravel: Develop clean MVC web applications</a> by Daniel Correa and Paola Vallejo reinforces MVC patterns with clean code practices.
        </p>
        <p>
          <a href="/books/6">The Complete Laravel 12 Guide: Build, Scale, and Deploy Modern Web Applications</a> by Allen Qwiz takes you from intermediate concepts all the way to deployment strategies. <a href="/books/10">Mastering Laravel 12</a> by Osbert A. Shaw introduces modern front-end integrations with Livewire and Inertia, giving you the tools to build full-stack applications without the complexity of traditional SPAs. <a href="/books/19">Ultimate Laravel for Modern Web Development</a> by Drishti Jain covers authentication, APIs, and cloud deployment in a single comprehensive volume.
        </p>

        <h2>Advanced Laravel Books</h2>
        <p>
          For experienced developers, advanced Laravel books dive into complex architectural patterns, performance optimisation, and building production-grade systems. <a href="/books/5">Laravel 12 Mastery: Build High-Performance Web Apps for Production</a> by John R. Coleman covers testing, scalable architecture, and real-time application development. <a href="/books/7">Advanced Practical Laravel: Become a Senior Laravel Developer in the Age of AI</a> by Pietro Curatola explores how modern AI tools integrate with Laravel development workflows.
        </p>
        <p>
          <a href="/books/16">Laravel 12 Clean Architecture: Designing Scalable and Maintainable Web Applications</a> by Stan Walton is essential reading for developers embracing SOLID principles and domain-driven design within Laravel. <a href="/books/14">Architecture of Complex Web Applications</a> by Adel Faizrakhmanov provides a deep dive into designing large-scale systems, covering patterns that extend beyond the framework itself. For those building subscription-based platforms, <a href="/books/8">Laravel for SaaS Applications</a> by Rodney S. Campbell is a comprehensive guide to designing, building, and scaling SaaS products.
        </p>

        <h2>Specialised Laravel Topics</h2>
        <p>
          Beyond general development, Laravel books cover a wide range of specialised domains. <a href="/books/2">Build a Multi Vendor Marketplace With Laravel</a> by Douglas Darwin walks through creating an e-commerce platform with multiple sellers, order management, and payment integration. <a href="/books/18">Laravel 12 and Vue 3 from Scratch</a> by Dr. Adrian Devlin bridges the gap between back-end Laravel development and modern front-end frameworks, giving you full-stack capabilities.
        </p>
        <p>
          <a href="/books/11">Laravel 12 for Beginners and Professionals: From Beginner to Advanced</a> by Roderick A. Reeves is a rare all-in-one resource that covers React, Vue, Livewire, and clean architecture in a single book, making it ideal for developers who want to explore multiple front-end technologies without buying separate resources. For those interested in the intersection of AI and Laravel development, the aforementioned <a href="/books/7">Advanced Practical Laravel</a> provides contemporary insights into this rapidly evolving space.
        </p>

        <h2>How to Choose the Right Laravel Book</h2>
        <p>
          Selecting the best Laravel book depends on your current skill level, learning style, and project goals. Beginners should start with a single comprehensive introduction like <a href="/books/3">Laravel 12 for Beginners & Beyond</a> before branching into specialised topics. Intermediate developers benefit most from books that cover architecture, testing, and deployment, such as <a href="/books/6">The Complete Laravel 12 Guide</a>. Advanced developers will find the most value in books focused on clean architecture, SaaS patterns, and performance optimisation.
        </p>
        <p>
          Consider the publication date carefully. Laravel evolves rapidly, and books covering Laravel 12 reflect the most current APIs, features, and best practices. Titles from 2025 onward, such as <a href="/books/5">Laravel 12 Mastery</a> and <a href="/books/16">Laravel 12 Clean Architecture</a>, ensure compatibility with the latest version of the framework. Older editions like <a href="/books/20">Laravel: Up & Running, 2e</a> remain valuable for understanding foundational concepts that transcend framework versions.
        </p>
        <p>
          Format availability is another consideration. Many Laravel books are available on Kindle Unlimited, allowing you to read them on any device. Paperback editions are ideal for deep study, while Kindle versions offer portability. Check the format details on each book page for pricing and availability information.
        </p>

        <h2>Complement Your Learning with Other Resources</h2>
        <p>
          While Laravel books provide structured knowledge, combining them with other learning resources accelerates your progress. Our <a href="/posts/">PHP tutorials and articles</a> cover specific topics in depth, from Eloquent performance tips to authentication best practices. The <a href="/magazines/">php|architect magazines</a> offer industry insights and case studies from professional developers. For hands-on reference, the <a href="/manual/">PHP manual</a> is an indispensable resource for understanding the language that powers Laravel.
        </p>
        <p>
          Whether you are building your first Laravel application or architecting a complex SaaS platform, the right book can transform your development journey. Browse our curated collection of <strong>{metadata.total_books} Laravel books</strong>, read the reviews, and choose the title that matches your current goals. Happy coding!
        </p>
      </div>
    </div>
  </section>
</BaseLayout>