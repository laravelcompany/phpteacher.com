---
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import BaseLayout from '@layouts/BaseLayout.astro'
import BlogCard from '@components/blog/BlogCard.astro'
import Pagination from '@components/blog/Pagination.astro'
import MainSection from '@components/ui/sections/MainSection.astro'
import { SITE } from '@/config'

export async function getStaticPaths() {
    const POSTS_PER_PAGE = 10

    const allPosts: CollectionEntry<'posts'>[] = (await getCollection('posts')).sort(
        (a: CollectionEntry<'posts'>, b: CollectionEntry<'posts'>) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
    )

    const totalPages = Math.ceil(allPosts.length / POSTS_PER_PAGE)
    const pages = []

    for (let page = 2; page <= totalPages; page++) {
        pages.push({
            params: { page: String(page) },
            props: { currentPage: page, totalPages, posts: allPosts },
        })
    }

    return pages
}

type Props = {
    currentPage: number
    totalPages: number
    posts: CollectionEntry<'posts'>[]
}

const POSTS_PER_PAGE = 10
const { currentPage, totalPages, posts: allPosts } = Astro.props
const pagePosts = allPosts.slice((currentPage - 1) * POSTS_PER_PAGE, currentPage * POSTS_PER_PAGE)

const description = 'Here are some articles that Stefan believes are not bad, hope you enjoy them.'
const URL = Astro.url.href
---

<BaseLayout
    title={`All Blogs - Page ${currentPage}`}
    description={description}
    structuredData={{
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        'inLanguage': 'en-US',
        '@id': URL,
        'url': URL,
        'name': `All Blogs - Page ${currentPage} - ${SITE.title}`,
        'description': description,
        'isPartOf': {
            '@type': 'WebSite',
            'url': SITE.url,
            'name': SITE.title,
            'description': SITE.description,
        },
    }}
>
    <MainSection
        title="Latest programming news and articles"
        subTitle="Learn what is happening in the world of programming"
        btnExists={true}
        btnTitle="All Posts"
        btnURL="/posts"
    />

    <section class="mx-auto max-w-[85rem] px-4 py-8 sm:px-6 lg:px-8 2xl:max-w-full">
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {pagePosts.map(post => <BlogCard blog={post} />)}
        </div>
    </section>

    <Pagination currentPage={currentPage} totalPages={totalPages} baseUrl="/posts/" />
</BaseLayout>
