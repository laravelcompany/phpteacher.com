{
  "name": "phpteacher-com",
  "compatibility_date": "2026-03-25",
  "main": "src/worker.js",
  "assets": {
    "directory": "./dist",
    "binding": "STATIC",
    // Run the worker for every request: host redirects (/posts, www) must
    // fire even for paths that exist as static assets.
    "run_worker_first": true
  },
  "kv_namespaces": [
    {
      "binding": "BLOG_KV",
      "id": "459c8b0b5727499c87c1653d54ba2787"
    }
  ]
}
